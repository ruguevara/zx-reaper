; Room script 5: Escape !!!
;
; Op $8A with 1 makes the left edge solid: the player cannot leave this room to the left (observed: holding left stays
; at the edge), so the crusaders' chase of rooms 4-6 only goes one way.
; .
; Room 5: column 0, row 1 of the 5x5 map (left is room 4, right 6, up 0, down 10, counted modulo 25). Unpacks sprite
; set #R$6916. Subscripts: #R$82F0, #R$7443, #R$744B. No items.
@label=RoomScript05
b$7453 DEFB $97,$01         ; SPRITESET 1
 $7455 DEFB $87,$05         ; ROOMNAME 5 "Escape !!!"
 $7457 DEFB $83 ; CALL ScriptRoomPanel
@isub=DEFW ScriptRoomPanel
 $7458 DEFW $82F0
 $745A DEFB $83 ; CALL BlockGrassEarth
@isub=DEFW BlockGrassEarth
 $745B DEFW $7443
 $745D DEFB $99,$03,$14,$00,$20,$02,$13,$14 ; TILEBLOCKS 3 rectangles
 $7465 DEFB $06,$02,$12,$16,$04,$02
 $746B DEFB $83 ; CALL BlockTreeBark
@isub=DEFW BlockTreeBark
 $746C DEFW $744B
 $746E DEFB $99,$07,$06,$01,$02,$0E,$04,$07,$02,$10,$08,$0C,$02,$0C,$0C,$0F ; TILEBLOCKS 7 rectangles
 $747E DEFB $02,$08,$05,$0F,$02,$08,$07,$1B,$02,$01,$08,$1B,$02,$0C
 $748C DEFB $8B,$02,$8C,$86,$07,$06,$06,$08,$06,$09,$0E,$09,$1A,$0B,$00,$0D ; STAMPS 2 tiles $8C $86 at 7 positions
 $749C DEFB $0B,$0D,$1A
 $749F DEFB $8B,$02,$87,$88,$06,$07,$10,$08,$02,$0A,$08,$0B,$0D,$0B,$1C,$0D ; STAMPS 2 tiles $87 $88 at 6 positions
 $74AF DEFB $10
 $74B0 DEFB $92,$99,$05,$06,$08,$0E,$02,$0E ; STAMP1 tile $99 at 5 positions
 $74B8 DEFB $0D,$0E,$10,$0F,$1C
 $74BD DEFB $92,$81,$07,$11,$17,$13,$00,$13,$03,$13,$0A,$13,$12,$13,$1E,$13 ; STAMP1 tile $81 at 7 positions
 $74CD DEFB $1F
 $74CE DEFB $86,$00,$00,$20,$04,$8A ; FILLTILE row 0, col 0, 32x4, tile $8A
 $74D4 DEFB $8D,$02,$07,$89,$35,$04,$04,$03,$0B,$01,$08,$10,$06,$04,$01,$06 ; RUNS from row 2, col 7, tile $89, 53 runs
 $74E4 DEFB $02,$08,$01,$06,$01,$06,$01,$06,$05,$04,$02,$01,$01,$04,$01,$06
 $74F4 DEFB $0C,$04,$04,$0D,$0C,$04,$05,$07,$1A,$02,$08,$01,$15,$01,$21,$02
 $7504 DEFB $0B,$01,$0E,$01,$04,$03,$0A,$01,$18,$01
 $750E DEFB $8C,$0C,$07,$8B ; TILE1 row 12, col 7, tile $8B
 $7512 DEFB $8C,$04,$00,$8A ; TILE1 row 4, col 0, tile $8A
 $7516 DEFB $8A,$01         ; EDGES left
 $7518 DEFB $80             ; END
