; Item action: cross that can be taken while the lever is off
;
; The other set of crosses (see #R$A777). If Jean touches the cross while the lever state bits at #R$851E are 0 it is
; taken (#R$A78B); otherwise it is animated and drawn by the code at #R$A799, using frame offset 0 (bright cross) when
; the lever is off and 6 (thin cross) when it is on.
;
; F Carry set when Jean's box overlaps the item's box
@label=ActionCrossLeverOff
c$A782 JR NC,$A799   ;
 $A784 LD A,($851E)  ;
@isub=AND LEVER_STATE_MASK
 $A787 AND $07       ;
 $A789 JR NZ,$A799   ; lever on: not takeable
; Entry point used by #R$A777: Jean takes the cross. The flag becomes $FF (never created again), the status-bar
; crosses redraw #R$9C1B is armed (a RET until a 0 is written to it), the number of crosses at $854D goes up by one,
; then the slot is freed with sound effect 5.
@label=TakeCross
*$A78B POP HL        ; flag pointer
@isub=LD (HL),ITEM_GONE
 $A78C LD (HL),$FF   ;
 $A78E LD HL,$9C1B   ; crosses redraw: NOP
 $A791 LD (HL),$00   ;
 $A793 LD HL,$854D   ; crosses collected + 1
 $A796 INC (HL)      ;
 $A797 JR $A71F      ; sound, free the slot
; Not takeable (no touch, or the lever is on): step the frame animation (countdown in +8, reload in +9, frame in +A of
; the frame count in +B) as #R$A7CB does, and draw frame E + (lever state bits), that is the bright cross when the
; lever is off and the thin one (frames 6-11) when it is on.
@label=DrawCrossLeverOff
*$A799 POP HL        ; flag pointer
 $A79A POP BC        ; C = countdown, B = reload
 $A79B POP DE        ; E = frame, D = number of frames
 $A79C LD A,E        ;
 $A79D DEC C         ;
 $A79E JR NZ,$A7A8   ; countdown not over
 $A7A0 LD C,B        ; reload the countdown, next frame, wrap at D
 $A7A1 INC A         ;
 $A7A2 LD E,A        ;
 $A7A3 CP D          ;
 $A7A4 JR C,$A7A8    ;
 $A7A6 SUB D         ;
 $A7A7 LD E,A        ;
*$A7A8 LD L,A        ; frame without the lever offset
 $A7A9 LD A,($851E)  ;
@isub=AND LEVER_STATE_MASK
 $A7AC AND $07       ; + 0 (lever off) or + 6 (on)
 $A7AE ADD A,L       ;
 $A7AF JR $A7D9      ; store the counters, draw frame A (#R$A7D9)
