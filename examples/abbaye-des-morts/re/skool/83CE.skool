; Unused debug routine: move between rooms with the direction keys
;
; Not reached in normal play: the player routine #R$AAAB jumps here when the player state #R$A894 is $FF, a state that
; nothing sets (the code that would enter it at #R$AAC0 is skipped by a JR). Observed in the simulator by poking $FF
; into #R$A894. The routine reads the keys pressed this frame (#R$A2D1): when bit 5 is set it returns
; to normal play through #R$AD82; otherwise the low four bits (right, left, down, up) call #R$AD71, which moves
; #R$8509 one room that way and starts the room change, and the room number is then reduced modulo 25.
@label=DebugWarpRoom
c$83CE LD A,($A2D1)  ;
 $83D1 BIT 5,A       ;
 $83D3 JP NZ,$AD82   ;
 $83D6 AND $0F       ;
 $83D8 RET Z         ;
 $83D9 CALL $AD71    ;
 $83DC LD HL,$8509   ;
@label=DebugWarpRoom_Wrap
*$83DF LD A,(HL)     ;
 $83E0 SUB $19       ;
 $83E2 RET C         ;
 $83E3 LD (HL),A     ;
 $83E4 JR $83DF      ;
