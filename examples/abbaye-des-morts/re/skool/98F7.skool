; Draw-queue handler: 16-pixel-wide block, unmasked, into the redraw cells
;
; Handler of the jobs that #R$97FD queues (template #R$982E; the 16-pixel-wide graphics of the command at #R$ACE5).
; #R$97B7 calls it through JP (HL) with DE = job address + 1, after it has put the background of the flagged cells into
; the redraw cell buffers. For each character row of the job it finds the row's run in the redraw run list (#R$98E4
; for the first row, then the next record of the list, so the rows must be consecutive records) and the index of the
; job's column among the cells of the run. It stores the graphics over the two cells there, 8 pixel rows of 2 bytes
; in the pixel-row pages of the redraw cell buffer ($C500 + 256 x pixel row + index), and the attribute at $C400 + index
; for both cells. No outline mask: the background of the cells is replaced. The graphics are read by POP with SP set
; to them (16 bytes per character row, 2 bytes per pixel row); the stores alternate between the left and the right
; cell so that BC needs no swapping. SP and the graphics pointer are saved in self-modified operands.
; .
; Job fields used (template #R$982E): +2 word graphics address, +4 byte character rows, +5 byte first row, +6 byte
; column, +7 byte attribute.
; .
; Hardware: none; the screen is written later by #R$95FF. SP points into the graphics while it runs.
;
; DE Job address + 1 (the handler word has been read by the caller)
@label=DrawBlockJob
c$98F7 EX DE,HL      ;
 $98F8 INC L         ; job + 2: the graphics address goes to the operand at #R$992D, job + 4: character rows
 $98F9 LD C,(HL)     ;
 $98FA INC L         ;
 $98FB LD B,(HL)     ;
 $98FC INC L         ;
@isub=LD (SmcBlockGfx+1),BC
 $98FD LD ($992E),BC ;
 $9901 LD B,(HL)     ;
 $9902 INC L         ;
 $9903 EX DE,HL      ;
; Find the record of the row at DE (job + 5); the INC E then makes DE point at the column field (job + 6).
 $9904 CALL $98E4    ;
 $9907 INC E         ;
; One character row. Choose the run that holds the column: the last run that starts at or before it.
@label=DrawBlockJob_Row
*$9908 PUSH DE       ;
 $9909 PUSH BC       ;
*$990A LD C,(HL)     ;
 $990B INC L         ;
 $990C LD B,(HL)     ;
 $990D INC L         ;
 $990E DEC A         ;
 $990F JR Z,$991D    ;
 $9911 EX AF,AF'     ;
 $9912 LD A,(DE)     ;
 $9913 CP (HL)       ;
 $9914 JR C,$9919    ;
 $9916 EX AF,AF'     ;
 $9917 JR $990A      ;
*$9919 EX AF,AF'     ;
 $991A ADD A,A       ;
 $991B ADD A,L       ;
 $991C LD L,A        ;
; Cell index = column - first column of the run + index of the run's first cell; BC = page $C5, index = the cell's
; first pixel row in the redraw buffer. A = the attribute (job + 7).
*$991D EX DE,HL      ;
 $991E LD A,(HL)     ;
 $991F SUB C         ;
 $9920 ADD A,B       ;
 $9921 LD C,A        ;
 $9922 INC L         ;
@isub=LD B,PAGE_REDRAW_PIXELS
 $9923 LD B,$C5      ;
 $9925 PUSH BC       ;
 $9926 LD A,(HL)     ;
; Alternate set: DE = cell address in the buffer.
 $9927 EXX           ;
 $9928 POP DE        ;
@isub=LD (SmcBlockSP+1),SP
 $9929 LD ($9961),SP ; save SP
; The operand is the address of the next 16 bytes of graphics: set at #R$98FD, moved on at #R$995C after each row.
@label=SmcBlockGfx
 $992D LD HL,$992D   ;
; First pixel row: take 2 bytes from the graphics, then POP the 7 other pairs, storing left/right or right/left.
 $9930 LD C,(HL)     ;
 $9931 INC HL        ;
 $9932 LD B,(HL)     ;
 $9933 INC HL        ;
 $9934 LD SP,HL      ; SP = graphics
 $9935 EX DE,HL      ;
 $9936 LD (HL),C     ;
 $9937 INC L         ;
 $9938 LD (HL),B     ;
 $9939 INC H         ;
 $993A POP BC        ;
 $993B LD (HL),B     ;
 $993C DEC L         ;
 $993D LD (HL),C     ;
 $993E INC H         ;
 $993F POP BC        ;
 $9940 LD (HL),C     ;
 $9941 INC L         ;
 $9942 LD (HL),B     ;
 $9943 INC H         ;
 $9944 POP BC        ;
 $9945 LD (HL),B     ;
 $9946 DEC L         ;
 $9947 LD (HL),C     ;
 $9948 INC H         ;
 $9949 POP BC        ;
 $994A LD (HL),C     ;
 $994B INC L         ;
 $994C LD (HL),B     ;
 $994D INC H         ;
 $994E POP BC        ;
 $994F LD (HL),B     ;
 $9950 DEC L         ;
 $9951 LD (HL),C     ;
 $9952 INC H         ;
 $9953 POP BC        ;
 $9954 LD (HL),C     ;
 $9955 INC L         ;
 $9956 LD (HL),B     ;
 $9957 INC H         ;
 $9958 POP BC        ;
 $9959 LD (HL),B     ;
 $995A DEC L         ;
 $995B LD (HL),C     ;
@isub=LD (SmcBlockGfx+1),SP
 $995C LD ($992E),SP ; graphics pointer for the next row
; The operand is the stack pointer saved at #R$9929.
@label=SmcBlockSP
 $9960 LD SP,$9960   ; restore SP
; Attribute of both cells.
@isub=LD H,PAGE_REDRAW_ATTRS
 $9963 LD H,$C4      ;
 $9965 LD (HL),A     ;
 $9966 INC L         ;
 $9967 LD (HL),A     ;
 $9968 EXX           ;
; Next character row: HL = the record after this row's runs; skip its row number and read its run count.
 $9969 EX DE,HL      ;
 $996A POP BC        ;
 $996B POP DE        ;
 $996C INC L         ;
 $996D LD A,(HL)     ;
 $996E INC L         ;
 $996F DJNZ $9908    ;
 $9971 RET           ;
