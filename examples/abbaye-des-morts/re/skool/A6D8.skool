; Item action: arch from Pestilent Beast to Underground river (room 10)
;
; The blue arch of room 10 at row 17, column 23 with flag $8523; the mirror of #R$A6BC: sets the latch of the other
; arch ($8524), the arrival position to X $54, Y $3C (the arch in room 19) and enters room 19 through #R$A6F2.
;
; F Carry set when Jean's box overlaps the item's box
; SP Slot address + 4 on entry: the next stack word is the flag pointer (the action pops it); see #R$A5E9 for the slot layout
@label=ActionArchToRiver
c$A6D8 POP HL        ; flag pointer
 $A6D9 JR NC,$A706   ; not touching: release the latch
 $A6DB BIT 7,(HL)    ; latched: Jean has just arrived here
 $A6DD JR NZ,$A708   ;
 $A6DF LD HL,$8524   ; latch of the arch in room 19
 $A6E2 SET 7,(HL)    ;
 $A6E4 LD HL,$5400   ; arrival position: X = $54 (column 21) ...
 $A6E7 LD ($8512),HL ;
 $A6EA LD HL,$3C00   ; ... Y = $3C (row 15), 2-pixel units
 $A6ED LD ($8514),HL ;
@isub=LD A,ROOM_RIVER
 $A6F0 LD A,$13      ;
; Entry point used by #R$A6BC. A = new room. The room state becomes 2, which makes the main loop (#R$85FC) put Jean at
; the position in #R$8512/#R$8514 and enter the room, as after a death at a checkpoint.
@label=EnterRoomAtArch
*$A6F2 LD ($8509),A  ; new room number
@isub=LD A,STATE_RESPAWN
 $A6F5 LD A,$02      ;
 $A6F7 LD ($850C),A  ;
 $A6FA ADD A,A       ; player state 4: standing
 $A6FB LD ($A894),A  ;
@isub=LD A,SFX_PORTAL
 $A6FE LD A,$04      ;
 $A700 LD ($854F),A  ;
 $A703 JP $A7CB      ; draw the arch, next slot
; Entry point used by #R$A6BC: Jean is not touching the arch, clear its latch.
@label=ArchRelease
*$A706 RES 7,(HL)    ;
; Entry point used by #R$A6BC: draw the arch and go on.
@label=ArchIdle
*$A708 JP $A7CB      ;
