; Tile attributes: one byte per tile number
;
; The attribute (flash, bright, paper, ink) of each tile, in the layout of the attribute file. #R$976B stores it in
; the redraw buffer #R$C400 with the tile's bitmap, and #R$95FF writes it to the screen. Nearly all are an ink colour
; on black paper ($01-$07); bit 6 (bright) is set on a few ($42-$47). Tile $00 and tile $80 are both blank (attribute
; $00).
@label=TileAttrs
b$CE00 DEFB $00,$06,$06,$44,$44,$47,$07,$07,$07,$07,$07,$07,$07,$07,$07,$07 ;
 $CE10 DEFB $02,$02,$02,$02,$07,$07,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02 ;
 $CE20 DEFB $05,$05,$05,$05,$05,$05,$07,$06,$06,$06,$06,$06,$02,$45,$07,$07 ;
 $CE30 DEFB $07,$07,$07,$07,$07,$07,$07,$07,$07,$02,$02,$42,$42,$07,$07,$07 ;
 $CE40 DEFB $07,$07,$07,$07,$07,$07,$07,$07,$07,$07,$07,$07,$46,$00,$06,$06 ;
 $CE50 DEFB $06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06 ;
 $CE60 DEFB $06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06,$06 ;
 $CE70 DEFB $06,$06,$06,$06,$06,$47,$47,$02,$02,$02,$02,$47,$47,$42,$07,$07 ;
 $CE80 DEFB $00,$04,$02,$02,$02,$02,$02,$02,$02,$04,$44,$02,$02,$47,$47,$47 ;
 $CE90 DEFB $47,$07,$07,$07,$07,$07,$07,$07,$07,$02,$02,$02,$02,$02,$02,$01 ;
 $CEA0 DEFB $01,$01,$01,$01,$02,$02,$04,$02,$07,$07,$07,$07,$07,$07,$07,$07 ;
 $CEB0 DEFB $07,$01,$02,$02,$02,$07,$00,$02,$02,$02,$02,$02,$02,$02,$02,$02 ;
 $CEC0 DEFB $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01 ;
