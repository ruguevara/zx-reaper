; Behaviour block: the fire breath of the Pestilent Beast (kind 15, room 10)
;
; Used by the fire breath of the Beast (attribute $42): a red jet of two sprites, one under the other, that comes down
; from the mouth for the last 38 frames of a 110-frame cycle and kills Jean on contact; at the end of the cycle
; #R$B8C5 makes the two flames of #R$BD22 and #R$BD34 (hit box 46 x 14 pixels). After the 5 header bytes: attribute,
; width in bytes, height in 2-pixel units, and the four sprite addresses of the jet (two frames of each of the two
; sprites). Five groups of (attribute, shift table #R$AC9F, height, sprite addresses) follow, the last four with the
; sprites of the monk and of the crusaders: Unknown whether anything reads them (TODO).
@label=BehaviourBeastFire
b$9585 DEFB $00,$00,$17,$07,$02  ; hit box top, left, bottom, right (2-pixel units); slot +$15 (Unknown)
 $958A DEFB $42,$02,$0C  ; attribute, width (bytes), height (2-pixel units)
 $958D DEFW $D768    ; sprite $D768
 $958F DEFW $D76D    ; sprite $D76D
 $9591 DEFW $D76A    ; sprite $D76A
 $9593 DEFW $D76F    ; sprite $D76F
 $9595 DEFB $42      ; group 1: attribute
 $9596 DEFW $AC9F    ; shift table
 $9598 DEFB $04      ; height
 $9599 DEFW $EF40    ; sprite $EF40
 $959B DEFW $F740    ; sprite $F740
 $959D DEFB $46      ; group 2: attribute
 $959E DEFW $AC9F    ; shift table
 $95A0 DEFB $0C      ; height
 $95A1 DEFW $D700    ; sprite $D700 (monk)
 $95A3 DEFW $D721    ; sprite $D721 (monk)
 $95A5 DEFB $46      ; group 3: attribute
 $95A6 DEFW $AC9F    ; shift table
 $95A8 DEFB $0C      ; height
 $95A9 DEFW $D716    ; sprite $D716 (monk)
 $95AB DEFW $D737    ; sprite $D737 (monk)
 $95AD DEFB $45      ; group 4: attribute
 $95AE DEFW $AC9F    ; shift table
 $95B0 DEFB $0C      ; height
 $95B1 DEFW $D76E    ; sprite $D76E
 $95B3 DEFB $45      ; group 5: attribute
 $95B4 DEFW $AC9F    ; shift table
 $95B6 DEFB $0C      ; height
 $95B7 DEFW $D784    ; sprite $D784
