 $78BC DEFB $9B,$A6,$06,$01,$05,$02,$01,$06,$03,$08,$1D,$02,$08,$1E,$04,$10 ; RUNS_V tile $A6, 6 vertical runs
 $78CC DEFB $10,$01,$10,$11,$03
