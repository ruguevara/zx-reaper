; Parchment frame tiles: 12 bitmaps of 8x8 pixels
;
; The border pieces of the parchment window (a scroll with torn edges), 8 bytes each, copied to the screen by #R$9CB7
; (frame tile number = layout code - 2). The attributes of the frame cells and of the blank interior cells come from BC of #R$9C58 (C = frame, B = interior).
; .
; +0 top-left corner, +1 and +2 two variants of the top edge, +3 top-right corner, +4 and +6 left edge variants, +5
; and +7 right edge variants, +8 bottom-left corner, +9 and +10 bottom edge variants, +11 bottom-right corner (tile n
; is at $717F+8*n)
@label=ParchmentFrameTiles
b$717F DEFB $06,$0F,$1F,$3E,$5C,$89,$93,$47
 $7187 DEFB $00,$00,$FF,$FF,$FF,$FF,$FF,$FF
 $718F DEFB $00,$00,$61,$FF,$FF,$FF,$FF,$FF
 $7197 DEFB $60,$F0,$F8,$7C,$3A,$91,$C9,$E2
 $719F DEFB $7F,$3F,$3F,$3F,$3F,$7F,$7F,$3F
 $71A7 DEFB $FE,$FE,$FE,$FE,$FE,$FE,$FE,$FE
 $71AF DEFB $7F,$7F,$7F,$7F,$7F,$7F,$7F,$7F
 $71B7 DEFB $FC,$FE,$FE,$FC,$FC,$FC,$FC,$FE
 $71BF DEFB $47,$93,$89,$5C,$3E,$1F,$0F,$06
 $71C7 DEFB $FF,$FF,$FF,$FF,$FF,$FF,$00,$00
 $71CF DEFB $FF,$FF,$FF,$FF,$FF,$86,$00,$00
