; Draw two pixel rows of a 4-byte-wide sprite
;
; Called four times per character row by #R$9AD4. The first pixel row is stored from the left byte to the right, the
; second from the right byte to the left, so that HL and DE are back at the first column at the end and no pointer
; has to be reloaded. Each byte is combined with the background as in #R$99F2: (OutlineMasks[g] AND old byte) OR g.
; HL ends one pixel row down and DE two rows down.
; .
; The pointers are in the alternate register set (see #R$9972): HL = destination in the redraw cell buffer (H = pixel-row
; page, L = cell index), DE = graphics in the sprite sheet (D = pixel row, E = column), B = $FF so that BC addresses the
; outline mask table OutlineMasks ($FF00) by the graphics byte in C.
; .
; Hardware: none (the redraw cell buffer is in RAM).
;
; BC B = $FF; C is scratch
; DE Graphics: D = pixel row, E = column of the first byte
; HL Destination in the redraw cell buffer: H = pixel-row page, L = cell index of the first byte
; O:DE D advanced by 2 pixel rows
; O:HL H advanced by 1 pixel row
@label=DrawStripW4
c$9A94 LD A,(DE)     ;
 $9A95 LD C,A        ;
 $9A96 LD A,(BC)     ;
 $9A97 AND (HL)      ;
 $9A98 OR C          ;
 $9A99 LD (HL),A     ;
 $9A9A INC L         ;
 $9A9B INC E         ;
 $9A9C LD A,(DE)     ;
 $9A9D LD C,A        ;
 $9A9E LD A,(BC)     ;
 $9A9F AND (HL)      ;
 $9AA0 OR C          ;
 $9AA1 LD (HL),A     ;
 $9AA2 INC L         ;
 $9AA3 INC E         ;
 $9AA4 LD A,(DE)     ;
 $9AA5 LD C,A        ;
 $9AA6 LD A,(BC)     ;
 $9AA7 AND (HL)      ;
 $9AA8 OR C          ;
 $9AA9 LD (HL),A     ;
 $9AAA INC L         ;
 $9AAB INC E         ;
 $9AAC LD A,(DE)     ;
 $9AAD LD C,A        ;
 $9AAE LD A,(BC)     ;
 $9AAF AND (HL)      ;
 $9AB0 OR C          ;
 $9AB1 LD (HL),A     ;
 $9AB2 INC H         ;
 $9AB3 INC D         ;
 $9AB4 LD A,(DE)     ;
 $9AB5 LD C,A        ;
 $9AB6 LD A,(BC)     ;
 $9AB7 AND (HL)      ;
 $9AB8 OR C          ;
 $9AB9 LD (HL),A     ;
 $9ABA DEC L         ;
 $9ABB DEC E         ;
 $9ABC LD A,(DE)     ;
 $9ABD LD C,A        ;
 $9ABE LD A,(BC)     ;
 $9ABF AND (HL)      ;
 $9AC0 OR C          ;
 $9AC1 LD (HL),A     ;
 $9AC2 DEC L         ;
 $9AC3 DEC E         ;
 $9AC4 LD A,(DE)     ;
 $9AC5 LD C,A        ;
 $9AC6 LD A,(BC)     ;
 $9AC7 AND (HL)      ;
 $9AC8 OR C          ;
 $9AC9 LD (HL),A     ;
 $9ACA DEC L         ;
 $9ACB DEC E         ;
 $9ACC LD A,(DE)     ;
 $9ACD LD C,A        ;
 $9ACE LD A,(BC)     ;
 $9ACF AND (HL)      ;
 $9AD0 OR C          ;
 $9AD1 LD (HL),A     ;
 $9AD2 INC D         ;
 $9AD3 RET           ;
