; Ending text 1: "your doom will come / not by my hand / but by human hands"
;
; Run by the ending sequence #R$887B: clears the attributes and the screen, prints strings 43-45 centred at pixel rows
; 55, 75 and 95, and marks all cells for redraw.
@label=ScriptEnding1
b$8345 DEFB $8F,$00,$00,$20,$18,$00 ; FILLATTR row 0, col 0, 32x24, attribute $00
 $834B DEFB $81,$00,$00,$20,$B0,$00 ; FILLPIX pixel row 0, byte col 0, 32 bytes x 176 rows, byte $00
 $8351 DEFB $82,$02,$37     ; ALIGN mode 2, pixel row 55
 $8354 DEFB $85,$2B         ; PRINT string 43 "your doom will come"
 $8356 DEFB $82,$02,$4B     ; ALIGN mode 2, pixel row 75
 $8359 DEFB $85,$2C         ; PRINT string 44 "not by my hand"
 $835B DEFB $82,$02,$5F     ; ALIGN mode 2, pixel row 95
 $835E DEFB $85,$2D         ; PRINT string 45 "but by human hands"
 $8360 DEFB $90,$01         ; REDRAWMARK mark all cells
 $8362 DEFB $80             ; END
