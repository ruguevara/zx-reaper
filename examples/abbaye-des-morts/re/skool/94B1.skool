; Behaviour block: the grinning ghost that chases Jean (kind 8, room 11)
;
; Used by the smiling cyan ghost of Cave of illusions (attribute $45), which floats toward Jean through free space (#R$B44B).
; .
; Layout: see #R$93D3.
@label=BehaviourChaser
b$94B1 DEFB $01,$01,$06,$06,$02  ; hit box top, left, bottom, right; slot +$15 (Unknown)
 $94B6 DEFB $45      ; attribute
 $94B7 DEFW $AC9F    ; table of (first column, width) for x AND 3
 $94B9 DEFB $08      ; sprite height (2-pixel units)
@isub=DEFW BehaviourChaser+$D
 $94BA DEFW $94BE    ; sprites, first direction (left or up)
@isub=DEFW BehaviourChaser+$11
 $94BC DEFW $94C2    ; sprites, second direction (right or down)
 $94BE DEFW $D763    ; first direction, frame 0
 $94C0 DEFW $D76E    ; first direction, frame 1
 $94C2 DEFW $D779    ; second direction, frame 0
 $94C4 DEFW $D784    ; second direction, frame 1
