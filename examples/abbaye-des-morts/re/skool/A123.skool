; Script code $96: set the tile flags of a rectangle
;
; Operands: row, column, width, height, flag value. Stores the value in the tile flag of every cell of the rectangle
; (#R$A13D), replacing the whole flag byte (class bits and redraw mark). Used 4 times, always with $80: class 0
; (nothing to touch) and the redraw mark set (rooms 10, 11 and 16, at $794E, $7A17, $7A1D, $7D56).
; .
; The part from $A12B on is shared with #R$A168.
;
; HL Script pointer, at the operands
; O:HL Script pointer after the operands
@label=OpSetFlagRect
c$A123 CALL $A11A    ;
 $A126 LD A,(HL)     ;
 $A127 INC HL        ;
 $A128 PUSH HL       ;
 $A129 LD L,A        ; L = value; EX DE,HL then gives HL = (row, column), E = value
 $A12A EX DE,HL      ;
; Entry used by #R$A168: HL = (L row, H column), C width, B height, E flag value; the script pointer is on the stack
; and is popped into HL at the end.
@label=SetFlagRect
*$A12B PUSH BC       ;
 $A12C PUSH HL       ;
 $A12D LD B,C        ;
*$A12E PUSH HL       ; one cell of the row
 $A12F CALL $A13D    ;
 $A132 POP HL        ;
 $A133 INC H         ; next column
 $A134 DJNZ $A12E    ;
 $A136 POP HL        ;
 $A137 POP BC        ;
 $A138 INC L         ; next row
 $A139 DJNZ $A12B    ;
 $A13B POP HL        ;
 $A13C RET           ;
