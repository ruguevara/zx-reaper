; Behaviour block: a rat (kinds 2 and 3, room 2)
;
; Used by the two rats of Tower of the Bell (cyan, attribute $45, run along the floor).
; .
; Layout: see #R$93D3.
@label=BehaviourRat
b$9430 DEFB $03,$01,$06,$06,$02  ; hit box top, left, bottom, right; slot +$15 (Unknown)
 $9435 DEFB $45      ; attribute
 $9436 DEFW $AC9F    ; table of (first column, width) for x AND 3
 $9438 DEFB $08      ; sprite height (2-pixel units)
 $9439 DEFW $943D    ; sprites, first direction (left or up)
 $943B DEFW $9441    ; sprites, second direction (right or down)
 $943D DEFW $D763    ; first direction, frame 0
 $943F DEFW $D76E    ; first direction, frame 1
 $9441 DEFW $D779    ; second direction, frame 0
 $9443 DEFW $D784    ; second direction, frame 1
