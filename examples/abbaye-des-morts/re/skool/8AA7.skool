; Object type records: 12 records of 8 bytes, one per type of room item
;
; Found through #R$8A8F by the item spawner #R$897E, which copies the fields into the object slot (#R$A5E9 has the slot
; layout). Fields:
; .
; +0 byte: frames between two animation steps (slot +8 and +9)
; .
; +1 byte: number of animation frames (slot +$0B)
; .
; +2 word: the slot's handler, #R$A600 (RoomItemHandler), or #R$A822 for parchments (slot +0)
; .
; +4 word: frame list (#R$8B07), 4 bytes per frame (slot +$0C)
; .
; +6 byte: sprite width in bytes (slot +$0E)
; .
; +7 byte: sprite height in 2-pixel units (slot +$0F)
; .
; Only the heart, the crosses and the arch step through their frames by themselves (delays of 20, 5 and 3 frames; 2, 6 and
; 9 frames each). The other types have a frame count of 0: their action routine chooses the frame from the item's flag (the
; checkpoint, bell, levers, wheel) or there is only one. The church door trigger (type 7) has no frame list: it draws
; nothing.
@label=ObjectTypeRecords
b$8AA7 DEFB $14,$02  ; type 0 heart: frame delay, number of frames
 $8AA9 DEFW $A600    ; handler
 $8AAB DEFW $8B07    ; frame list
 $8AAD DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AAF DEFB $05,$06  ; type 1 cross (wheel off): frame delay, number of frames
 $8AB1 DEFW $A600    ; handler
 $8AB3 DEFW $8B0F    ; frame list
 $8AB5 DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AB7 DEFB $05,$06  ; type 2 cross (wheel on): frame delay, number of frames
 $8AB9 DEFW $A600    ; handler
 $8ABB DEFW $8B0F    ; frame list
 $8ABD DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8ABF DEFB $00,$00  ; type 3 checkpoint: frame delay, number of frames
 $8AC1 DEFW $A600    ; handler
 $8AC3 DEFW $8B3F    ; frame list
 $8AC5 DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AC7 DEFB $00,$00  ; type 4 bell: frame delay, number of frames
 $8AC9 DEFW $A600    ; handler
 $8ACB DEFW $8B73    ; frame list
 $8ACD DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8ACF DEFB $00,$00  ; type 5 parchment: frame delay, number of frames
 $8AD1 DEFW $A822    ; handler
 $8AD3 DEFW $8B6B    ; frame list
 $8AD5 DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AD7 DEFB $00,$00  ; type 6 red scroll: frame delay, number of frames
 $8AD9 DEFW $A600    ; handler
 $8ADB DEFW $8B6F    ; frame list
 $8ADD DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8ADF DEFB $01,$00  ; type 7 church door trigger: frame delay, number of frames
 $8AE1 DEFW $A600    ; handler
 $8AE3 DEFW $0000    ; frame list
 $8AE5 DEFB $00,$00  ; sprite width (bytes), height (2-pixel units)
 $8AE7 DEFB $03,$09  ; type 8 arch: frame delay, number of frames
 $8AE9 DEFW $A600    ; handler
 $8AEB DEFW $8B47    ; frame list
 $8AED DEFB $02,$0C  ; sprite width (bytes), height (2-pixel units)
 $8AEF DEFB $00,$00  ; type 9 lever: frame delay, number of frames
 $8AF1 DEFW $A600    ; handler
 $8AF3 DEFW $8B7B    ; frame list
 $8AF5 DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AF7 DEFB $00,$00  ; type 10 wheel lever: frame delay, number of frames
 $8AF9 DEFW $A600    ; handler
 $8AFB DEFW $8B83    ; frame list
 $8AFD DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
 $8AFF DEFB $00,$00  ; type 11 chalice: frame delay, number of frames
 $8B01 DEFW $A600    ; handler
 $8B03 DEFW $8B8B    ; frame list
 $8B05 DEFB $02,$08  ; sprite width (bytes), height (2-pixel units)
