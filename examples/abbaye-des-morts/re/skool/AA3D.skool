; Kill Jean: lose a life and play the dying animation
;
; Reached from the player routine (#R$AAC6) when the hit flag #R$A8A0 is not zero: takes one life (#R$854C), requests
; sound effect 6, starts the dying animation (animation timer 4, frame 0), clears the hit flag and sets the player
; state to 1 (dying). Falls into #R$AA56, which also runs on every later frame of the animation. The dying monk rises
; one pixel per frame, 7 frames of the animation each 4 frames long in bright red (frames of #R$ACB3), then 4 frames
; with nothing drawn; after that #R$AA99 asks for the restart of the room. The animation takes 32 frames (observed).
; .
; Hardware: none; sound effect request only.
@label=KillPlayer
c$AA3D LD HL,$854C   ; one life less
 $AA40 DEC (HL)      ;
@isub=LD A,SFX_DEATH
 $AA41 LD A,$06      ;
 $AA43 LD ($854F),A  ;
@isub=LD A,DYING_ANIM_PERIOD
 $AA46 LD A,$04      ;
 $AA48 LD ($A895),A  ;
 $AA4B XOR A         ; frame 0
 $AA4C LD ($A896),A  ;
 $AA4F LD ($A8A0),A  ; clear the hit flag
 $AA52 INC A         ; A = 1: dying
 $AA53 LD ($A894),A  ;
; One step of the dying animation; entered every frame in state 1 from #R$AAAB. The timer counts down from 4; at zero
; the frame number goes up by one.
@label=UpdateDying
*$AA56 LD HL,$A895   ; timer
 $AA59 DEC (HL)      ;
 $AA5A JR NZ,$AA62   ;
@isub=LD (HL),DYING_ANIM_PERIOD
 $AA5C LD (HL),$04   ;
 $AA5E LD HL,$A896   ;
 $AA61 INC (HL)      ;
@label=UpdateDying_Frame
*$AA62 LD A,($A896)  ; frame
@isub=CP DYING_LAST_FRAME
 $AA65 CP $07        ; frame 7 is not drawn, then it is over
 $AA67 RET Z         ; frame 7: draw nothing, wait
 $AA68 JR NC,$AA99   ; frame 8: finished
 $AA6A LD HL,($A8A3) ;
@isub=LD DE,DYING_RISE
 $AA6D LD DE,$0080   ; the monk rises one pixel per frame
 $AA70 OR A          ;
 $AA71 SBC HL,DE     ;
 $AA73 LD ($A8A3),HL ; Y = Y - $0080
 $AA76 LD HL,($A8A3) ;
 $AA79 LD A,H        ;
 $AA7A LD HL,($A8A1) ; H = X, L = Y
 $AA7D LD L,A        ;
 $AA7E SRA H         ; H = X / 4: byte column
 $AA80 SRA H         ;
 $AA82 LD ($ACD3),HL ; position of the draw command (y, byte column)
 $AA85 LD BC,$AC9F   ; shift pairs
 $AA88 LD HL,$ACB3   ; dying frames, for either facing
 $AA8B LD DE,$ACB3   ;
@isub=LD A,MONK_HEIGHT
 $AA8E LD A,$0C      ; height, kept on the stack for #R$AC1C
 $AA90 PUSH AF       ;
@isub=LD A,BRIGHT+RED
 $AA91 LD A,$42      ; attribute: bright red
 $AA93 LD ($ACDA),A  ; attribute of the draw command
 $AA96 JP $AC1C      ; draw frame A896 of the table, like the walking monk
; The animation is over: ask the main loop (#R$85FC) to restart the room, or to show Game Over when no life is left,
; and have the hearts of the status bar redrawn (#R$9BF3).
@label=UpdateDying_End
*$AA99 LD A,($854C)  ; lives left?
 $AA9C OR A          ;
 $AA9D LD HL,$850C   ; room state
@isub=LD (HL),STATE_DEATH
 $AAA0 LD (HL),$84   ; restart the room after a death
 $AAA2 JR NZ,$AAA5   ; lives left
 $AAA4 INC (HL)      ; room state $85: Game Over
*$AAA5 LD DE,$9BF3   ; hearts bar redraw gate: NOP re-arms it
 $AAA8 XOR A         ;
 $AAA9 LD (DE),A     ;
 $AAAA RET           ;
