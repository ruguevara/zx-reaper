; Animate the bubbling blood tiles of the bottom row
;
; Called once per frame by the main loop #R$85FC. The byte at #R$AE20 is RET until the room script uses op $9E
; (#R$A1B9, rooms 21, 22 and 23: the red blood at the foot of the room), which makes it NOP; room entry (#R$86B9) puts
; the RET back. Every second frame (#R$8510) it goes along the bottom row of the tile map (row 21) and swaps tile $3B
; for $3C and $3C for $3B, and sets the redraw bit in the tile flag map for each cell it changed, so that the blood
; flickers. The cells keep their flag class, the swap only changes what is drawn.
;
; Hardware: none directly (the redraw routine #R$9B5A paints the marked cells).
@label=AnimateBloodTiles
c$AE20 NOP           ; RET unless op $9E of the room script switched the animation on
 $AE21 LD HL,$8510   ; frame counter
 $AE24 DEC (HL)      ;
 $AE25 RET NZ        ;
@isub=LD (HL),LIQUID_ANIM_PERIOD
 $AE26 LD (HL),$02   ; every second frame
@isub=LD BC,SCREEN_COLS*256+1
 $AE28 LD BC,$2001   ; B = 32 cells of the row (C is not used)
@isub=LD DE,TILE_MAP+(MAP_ROWS-1)*SCREEN_COLS
 $AE2B LD DE,$5DA0   ; tile map, row 21
@isub=LD HL,FLAG_MAP+(MAP_ROWS-1)*SCREEN_COLS
 $AE2E LD HL,$60A0   ; tile flag map, row 21 (same low byte as DE)
@label=AnimateBloodTiles_Cell
*$AE31 LD A,(DE)     ;
@isub=CP TILE_BLOOD_A
 $AE32 CP $3B        ;
 $AE34 JR Z,$AE3E    ;
@isub=CP TILE_BLOOD_B
 $AE36 CP $3C        ;
 $AE38 JR Z,$AE42    ;
 $AE3A INC E         ; some other tile: next cell
 $AE3B DJNZ $AE31    ;
 $AE3D RET           ;
*$AE3E INC A         ; $3B becomes $3C
 $AE3F LD (DE),A     ;
 $AE40 JR $AE44      ;
*$AE42 DEC A         ; $3C becomes $3B
 $AE43 LD (DE),A     ;
*$AE44 LD L,E        ;
 $AE45 SET 7,(HL)    ; FLAG_REDRAW: mark the cell for redraw
 $AE47 INC E         ;
 $AE48 DJNZ $AE31    ;
 $AE4A RET           ;
