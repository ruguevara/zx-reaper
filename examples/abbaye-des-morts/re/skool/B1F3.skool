; Crusader: take the next command of the path script
;
; Reached from #R$B1D4 when the high byte of x equals the target of the pair at the path pointer. Moves the path pointer
; to the next pair, writes the handler of the command (table #R$B20C) over the handler word of the slot and stores x,
; the path pointer and the speed back, then goes on with the drawing of this frame at #R$B1DF.
;
; DE Path pointer (at the target byte of the pair)
; HL x (8.8)
; BC x speed
; SP Slot address + 8
@label=UpdateCrusader_Command
c$B1F3 INC DE        ; the command byte of the pair
 $B1F4 LD A,(DE)     ;
 $B1F5 INC DE        ; DE = next pair
 $B1F6 PUSH HL       ; store x at slot + 6 (SP was at slot + 8) ...
 $B1F7 PUSH DE       ; ... the path pointer at slot + 4 ...
 $B1F8 PUSH BC       ; ... and the speed at slot + 2
 $B1F9 LD L,A        ;
 $B1FA LD H,$00      ;
 $B1FC ADD HL,HL     ;
 $B1FD LD DE,$B20C   ; PathCommands
 $B200 ADD HL,DE     ;
 $B201 LD E,(HL)     ;
 $B202 INC HL        ;
 $B203 LD D,(HL)     ; DE = handler of the command
 $B204 PUSH DE       ; ... and it over the handler word at slot + 0
 $B205 POP AF        ; pop the handler word again (SP at slot + 2); AF is not used
 $B206 POP BC        ; BC = speed
 $B207 POP DE        ; the path pointer
 $B208 POP DE        ; DE = x
 $B209 JP $B1DF      ; go on with this frame as if nothing had happened
