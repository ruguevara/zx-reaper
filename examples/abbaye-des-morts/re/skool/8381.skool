; Ending text 3: "Your body has burned in the flames, but your soul has found a place in Heaven."
;
; Run at the end of the ending sequence #R$887B: clears the attributes and the screen (176 + 16 pixel rows), prints
; strings 49-52 centred at pixel rows 28, 48, 128 and 148 and sets the attributes to white on black.
@label=ScriptEnding3
b$8381 DEFB $8F,$00,$00,$20,$18,$00 ; FILLATTR row 0, col 0, 32x24, attribute $00
 $8387 DEFB $81,$00,$00,$20,$C0,$00 ; FILLPIX pixel row 0, byte col 0, 32 bytes x 192 rows, byte $00
 $838D DEFB $82,$02,$1C     ; ALIGN mode 2, pixel row 28
 $8390 DEFB $85,$31         ; PRINT string 49 "Your body has burned"
 $8392 DEFB $82,$02,$30     ; ALIGN mode 2, pixel row 48
 $8395 DEFB $85,$32         ; PRINT string 50 "in the flames,"
 $8397 DEFB $82,$02,$80     ; ALIGN mode 2, pixel row 128
 $839A DEFB $85,$33         ; PRINT string 51 "but your soul has found"
 $839C DEFB $82,$02,$94     ; ALIGN mode 2, pixel row 148
 $839F DEFB $85,$34         ; PRINT string 52 "a place in Heaven."
 $83A1 DEFB $8F,$00,$00,$20,$18,$07 ; FILLATTR row 0, col 0, 32x24, attribute $07
 $83A7 DEFB $80             ; END
