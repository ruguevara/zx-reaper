; Erase the door at the right edge of room 20
;
; Fills the 1x4 cells at row 14, column 31 with the blank tile $80. Run through #R$9CEE by the lever of room 20
; (#R$A75A) when it is pulled.
@label=EraseDoorRight
b$8048 DEFB $86,$0E,$1F,$01,$04,$80 ; FILLTILE row 14, col 31, 1x4, tile $80
 $804E DEFB $80             ; END
