; Attribute address of a cell
;
; Converts a cell row and column into the address of the cell's attribute byte: $5800 + 32 x row + column. Used by
; #R$9FA8, #R$A168 and two routines at #R$9BA7 and #R$9CA5.
; .
; Hardware: knows the address of the attribute file.
;
; L Cell row 0-23
; H Cell column 0-31
; O:HL Attribute address
@label=AttrAddress
c$A1F2 LD A,L        ;
 $A1F3 RRCA          ;
 $A1F4 RRCA          ;
 $A1F5 RRCA          ;
 $A1F6 LD L,A        ;
 $A1F7 AND $E0       ;
 $A1F9 ADD A,H       ;
 $A1FA LD H,A        ;
 $A1FB LD A,L        ;
 $A1FC AND $03       ;
@isub=ADD A,ATTRS_HIGH
 $A1FE ADD A,$58     ;
 $A200 LD L,H        ;
 $A201 LD H,A        ;
 $A202 RET           ;
