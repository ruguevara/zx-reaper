; Save the game to tape and verify it
;
; Handler of the word SAVE. Copies the three Bard script bytes from $C9E2 to
; SavedScriptBytes (#R$84B3), prints "Start tape then press any key." in the
; input window, waits for a key and writes the four state blocks with the
; ROM's SA-BYTES in the same order and with the same lengths that #R$8451
; loads: SavedScriptBytes, Chr00Player, Timers, Loc00None. Then prints
; "Rewind and prepare tape for verification -- then hit any key.", waits for a
; key and checks the four blocks against memory with #R$855A (LD-BYTES with
; carry clear), which reports a mismatch itself and ends the command through
; #R$8553. The blocks have no header, only the flag byte $FF.
; .
; Hardware: the ROM tape routines SA-BYTES and LD-BYTES (they re-enable
; interrupts, so the routine executes DI at the end); the keyboard port $FE.
@label=SaveGame
c$84CC PUSH IX       ;
 $84CE PUSH DE       ;
 $84CF LD DE,$B6EB   ; copy the script bytes from the script area
 $84D2 LD HL,$C9E2   ; to SavedScriptBytes
 $84D5 CALL $84B3    ;
 $84D8 LD A,$01      ;
 $84DA LD ($B701),A  ; print in the input window
 $84DD LD HL,$B342   ; "Start tape then press any key."
 $84E0 CALL $72DD    ;
 $84E3 CALL $84B9    ; wait for a key
@isub=LD A,TAPE_FLAG_DATA
 $84E6 LD A,$FF      ; flag byte of the block
 $84E8 LD IX,$B6EB   ; saved variables
@isub=LD DE,STATE_VARS_SIZE
 $84EC LD DE,$001D   ;
 $84EF CALL $04C2    ;
@isub=LD A,TAPE_FLAG_DATA
 $84F2 LD A,$FF      ;
 $84F4 LD IX,$C11B   ; object and character records
@isub=LD DE,STATE_OBJECTS_SIZE
 $84F8 LD DE,$0615   ;
 $84FB CALL $04C2    ;
@isub=LD A,TAPE_FLAG_DATA
 $84FE LD A,$FF      ;
 $8500 LD IX,$CA84   ; timers and NPC records
@isub=LD DE,STATE_TIMERS_SIZE
 $8504 LD DE,$00BF   ;
 $8507 CALL $04C2    ;
@isub=LD A,TAPE_FLAG_DATA
 $850A LD A,$FF      ;
 $850C LD IX,$BA8A   ; location records
@isub=LD DE,STATE_LOCATIONS_SIZE
 $8510 LD DE,$05D9   ;
 $8513 CALL $04C2    ;
 $8516 LD HL,$B3A4   ; "Rewind and prepare tape for verification -- then hit any key."
 $8519 CALL $72DD    ;
 $851C CALL $84B9    ; wait for a key
@isub=LD A,TAPE_FLAG_DATA
 $851F LD A,$FF      ;
 $8521 AND A         ; carry clear: verify
 $8522 LD IX,$B6EB   ;
@isub=LD DE,STATE_VARS_SIZE
 $8526 LD DE,$001D   ;
 $8529 CALL $855A    ;
@isub=LD A,TAPE_FLAG_DATA
 $852C LD A,$FF      ;
 $852E AND A         ;
 $852F LD IX,$C11B   ;
@isub=LD DE,STATE_OBJECTS_SIZE
 $8533 LD DE,$0615   ;
 $8536 CALL $855A    ;
@isub=LD A,TAPE_FLAG_DATA
 $8539 LD A,$FF      ;
 $853B AND A         ;
 $853C LD IX,$CA84   ;
@isub=LD DE,STATE_TIMERS_SIZE
 $8540 LD DE,$00BF   ;
 $8543 CALL $855A    ;
@isub=LD A,TAPE_FLAG_DATA
 $8546 LD A,$FF      ;
 $8548 AND A         ;
 $8549 LD IX,$BA8A   ;
@isub=LD DE,STATE_LOCATIONS_SIZE
 $854D LD DE,$05D9   ;
 $8550 CALL $855A    ;
; This entry point is used by the routine at #R$855A.
@label=SaveGame_End
*$8553 DI            ; the ROM returned with interrupts on
 $8554 POP DE        ;
 $8555 POP IX        ;
 $8557 JP $82B3      ;
