; Print a command as a sentence
;
; Writes the chosen command (CommandId, FirstObject, SecondObject, Subject)
; as a sentence: "You take the short strong sword.", "Gandalf gives the
; curious map to you.", "You cannot take the wooden chest.". The parts, in
; order: the name of the subject; "cannot" when ActionAllowed is 0; the word
; at record +6 of the command table record (the "go" of the ten moves); the
; verb word at +0 (a move in the dark prints "somewhere" instead of the
; direction); the first noun's name phrase, preceded by the record's
; prepositions when the flags say so (CMDF_PREP1_BEFORE, CMDG_PREP2_BEFORE:
; "climb out of the pit", "take off the cloak"); the other prepositions and the
; second noun ("put the map in the chest"); a full stop and a new line. A
; command with CMDF_SILENT (look, inventory) prints nothing.
; .
; A command that is allowed (ActionAllowed 1) is printed in the story window,
; on a new line when the player acts. A refused one goes to the input window
; (RawOutputFlag 1), after the prompt line. While it runs the byte $70DF is 1,
; which makes the article printer use the table "the, the, the, some"
; (#R$743F). PhraseMode is cleared. RawOutputFlag is left as set here.
; .
; Hardware: none directly; the characters go to the screen through
; #R$858B.
;
; O:A 0
; O:F Z set
; O:RawOutputFlag 0 when the command was allowed, 1 when it was refused
@label=PrintCommandSentence
c$712B LD A,$01      ; $70DF = 1: a command sentence is being built
 $712D LD ($70DF),A  ;
 $7130 XOR A         ;
 $7131 LD ($B703),A  ; PhraseMode 0
 $7134 PUSH IY       ;
 $7136 PUSH BC       ;
 $7137 LD A,($B6FB)  ; ActionAllowed
 $713A LD B,A        ; B = allowed (1) or refused (0)
 $713B AND A         ;
 $713C LD A,$01      ; refused: input window
 $713E JR Z,$7141    ;
 $7140 XOR A         ; allowed: story window
*$7141 LD ($B701),A  ; RawOutputFlag
 $7144 PUSH IX       ;
 $7146 PUSH HL       ;
 $7147 PUSH DE       ;
 $7148 LD A,($B6E7)  ; CommandId
 $714B CALL $70E8    ; CommandRecordAddr
 $714E PUSH HL       ;
 $714F POP IX        ; IX = the command table record
 $7151 XOR A         ;
 $7152 CP B          ;
 $7153 JR Z,$715C    ; refused: no new line
 $7155 LD A,($B6EA)  ; Subject
 $7158 AND A         ;
 $7159 CALL Z,$8583  ; the player acts: start on a new line
*$715C CALL $70F3    ; PackCommandFlags: A = C = StateB71D
@isub=BIT CMDF_SILENT,A
 $715F BIT 4,A       ;
 $7161 LD C,A        ;
 $7162 JP NZ,$71C9   ; silent command (look, inventory): print nothing
 $7165 CALL $73A7    ; the subject's name
@isub=LD DE,WORD_CANNOT
 $7168 LD DE,$00EE   ;
 $716B XOR A         ;
 $716C CP B          ;
 $716D CALL Z,$74C1  ; refused: "cannot"
 $7170 PUSH HL       ;
 $7171 LD DE,$0006   ;
 $7174 ADD HL,DE     ;
 $7175 CALL $74BA    ; the word at record +6 ("go"), usually empty
 $7178 CALL $95ED    ; CheckDark
 $717B POP HL        ; HL = record
 $717C JR NC,$718F   ;
 $717E LD A,($B6E7)  ; in the dark:
@isub=CP CMD_FIRST_OTHER
 $7181 CP $0B        ;
 $7183 JR NC,$718F   ; not a move
@isub=LD DE,WORD_SOMEWHERE
 $7185 LD DE,$0AEA   ;
 $7188 INC HL        ;
 $7189 INC HL        ; skip the direction word
 $718A CALL $74C1    ; "go somewhere"
 $718D JR $7192      ;
*$718F CALL $74BA     ; the verb word (+0)
@isub=BIT CMDF_NOUN1,C
*$7192 BIT 3,C        ; has a first noun?
 $7194 JR Z,$71A6    ;
@isub=BIT CMDF_PREP1_BEFORE,C
 $7196 BIT 5,C       ;
 $7198 CALL NZ,$74BA ; preposition before the noun ("off", "out")
 $719B LD A,($B71E)  ; StateB71E
@isub=BIT CMDG_PREP2_BEFORE,A
 $719E BIT 7,A       ;
 $71A0 CALL NZ,$74BA ; second preposition before the noun ("of")
 $71A3 CALL $73B4    ; the first noun, with its article
*$71A6 LD A,($B6E9)  ; SecondObject
@isub=CP NO_OBJECT
 $71A9 CP $FF        ;
 $71AB JR Z,$71C1    ; no second noun
@isub=BIT CMDF_NOUN2,C
 $71AD BIT 2,C       ;
 $71AF JR Z,$71C1    ;
@isub=BIT CMDF_PREP1_BEFORE,C
 $71B1 BIT 5,C       ;
 $71B3 CALL Z,$74BA  ; preposition between the nouns ("to", "in")
 $71B6 LD A,($B71E)  ;
@isub=BIT CMDG_PREP2_BEFORE,A
 $71B9 BIT 7,A       ;
 $71BB CALL Z,$74BA  ;
 $71BE CALL $73C7    ; the second noun, with its article
@isub=LD A,CHAR_FULLSTOP
*$71C1 LD A,$2E      ; "."
 $71C3 CALL $858B    ; PrintChar
 $71C6 CALL $8583    ; PrintNewLine
*$71C9 XOR A         ;
 $71CA LD ($70DF),A  ; the sentence is done
 $71CD POP DE        ;
 $71CE POP HL        ;
 $71CF POP IX        ;
 $71D1 POP BC        ;
 $71D2 POP IY        ;
 $71D4 RET           ;
