; NPC turn: the NPC is held by something
;
; Part of the NPC loop (#R$980E), taken when the NPC's record has a holder (+1 is not
; AT_LOCATION). FirstObject becomes the holder and SecondObject none. When the holder is
; dead or disabled (FLAG_DEAD) or a character, the NPC acts as usual (jump to #R$9870).
; When the holder is shut (FLAG_ACTIVE clear) the NPC does nothing this turn (#R$9901,
; the next NPC). Otherwise it climbs out of the open holder: CommandId := CMD_CLIMB_OUT_OF
; is carried out for the NPC by #R$99C6 (a barrel, a boat), and the loop goes on with
; the next NPC.
;
; IX Record of the NPC (set by the loop)
@label=NpcHeld
@isub=LD A,NO_OBJECT
c$9B16 LD A,$FF            ; SecondObject := none
 $9B18 LD ($B6E9),A        ;
 $9B1B LD A,(IX+$01)       ; FirstObject := the holder
 $9B1E LD ($B6E8),A        ;
 $9B21 CALL $9BCA          ; IX = the holder's record
@isub=BIT FLAG_DEAD,(IX+$07)
 $9B24 BIT 3,(IX+$07)      ; dead or disabled holder
 $9B28 JP NZ,$9870         ; the NPC acts normally
@isub=BIT FLAG_CHARACTER,(IX+$07)
 $9B2B BIT 6,(IX+$07)      ; a character holds it
 $9B2F JP NZ,$9870         ; the NPC acts normally
@isub=BIT FLAG_ACTIVE,(IX+$07)
 $9B32 BIT 5,(IX+$07)      ; open?
 $9B36 JP Z,$9901          ; no: skip this NPC
@isub=LD A,CMD_CLIMB_OUT_OF
 $9B39 LD A,$37            ;
 $9B3B LD ($B6E7),A        ; CommandId := climb out of
 $9B3E CALL $99C6          ; the NPC does it
 $9B41 JP $9901            ; next NPC
