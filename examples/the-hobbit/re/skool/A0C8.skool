; List the doors and other obstacles on the exits of a location
;
; Prints one line "To the <direction> there is <thing>" for every exit whose
; obstacle (door, river, web, portcullis: the second byte of the exit) is an
; object present in the game; for up and down the line starts with "above" or
; "below" instead of "To the". Part of every location description (#R$965B),
; before the list of the plain exits (#R$A138).
; .
; Hardware: none (the text goes through the message printer).
;
; A Location id
; Preserves BC, DE, IX and IY.
@label=ListExitObstacles
c$A0C8 PUSH BC
 $A0C9 PUSH DE
 $A0CA PUSH IY
 $A0CC PUSH IX
 $A0CE CALL $A0AE     ; IX = location record + 7, BC = 3
 $A0D1 ADD IX,BC      ; IX = first exit (direction, obstacle, destination)
 $A0D3 PUSH IX
 $A0D5 POP IY         ; IY walks the exits
@label=ListExitObstacles_Next
*$A0D7 SUB A          ; obstacle 0: nothing to say
 $A0D8 CP (IY+$01)
 $A0DB JR Z,$A113
 $A0DD LD A,(IY+$01)
 $A0E0 CALL $9BCA     ; IX = the obstacle record
@isub=BIT FLAG_PRESENT,(IX+$07)
 $A0E3 BIT 7,(IX+$07) ; not present in the game: skip
 $A0E7 JR Z,$A113
 $A0E9 LD DE,$0008
 $A0EC ADD IX,DE      ; IX = its first name phrase (+8), the <thing> of the message
 $A0EE PUSH IX
 $A0F0 LD A,(IY+$00)
 $A0F3 CALL $A0BA     ; DE = direction word
@isub=CP DIR_UP
 $A0F6 CP $09         ; the eight compass directions are below 9
 $A0F8 JR C,$A104
@isub=LD DE,WORD_ABOVE
 $A0FA LD DE,$07B5
 $A0FD JR Z,$A10A     ; up
@isub=LD DE,WORD_BELOW
 $A0FF LD DE,$082B
 $A102 JR $A10A
*$A104 LD HL,$AE17    ; "To the"
 $A107 CALL $72DD
*$A10A CALL $74C1     ; the direction word, or above / below
 $A10D LD HL,$B013    ; "There is <thing>"
 $A110 CALL $72DD
*$A113 ADD IY,BC      ; next exit
@isub=LD A,END_MARK
 $A115 LD A,$FF
 $A117 CP (IY+$00)
 $A11A JP NZ,$A0D7
 $A11D POP IX
 $A11F POP IY
 $A121 POP DE
 $A122 POP BC
 $A123 RET
