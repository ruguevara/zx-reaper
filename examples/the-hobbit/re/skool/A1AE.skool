; Find the record in table $C060 whose id matches IY+1 (unreferenced), then
; $A1C8 test
c$A1AE PUSH IY       ;
 $A1B0 PUSH IX       ;
 $A1B2 LD IX,$C060   ;
*$A1B6 CALL $9BA9    ;
 $A1B9 JR Z,$A1C0    ;
 $A1BB CP (IY+$01)   ;
 $A1BE JR NZ,$A1B6   ;
*$A1C0 LD A,(IX+$00) ;
 $A1C3 POP IX        ;
 $A1C5 POP IY        ;
 $A1C7 RET           ;
 $A1C8 LD A,(IX+$07) ;
 $A1CB AND $48       ;
 $A1CD CP $40        ;
 $A1CF RET           ;
