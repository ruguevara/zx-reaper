; Report or ask about a missing second noun phrase
;
; Reached from #R$7D98 when the command has no second noun phrase (bit 0 of
; RecWork1, $793E, clear). Pushes the words for the message: the command
; record's words that follow the noun (#R$7E78), a 0, the name of FirstObject
; (#R$71E2), the words that precede the noun (#R$7E7C) and the verb (RecWord1).
; Then, when RecWork3+1 ($7941) is 0 (no object could serve), prints message
; $ADE7, "I see nothing to {verb} {word} {word} {THING} {word} {word} {word}"
; (seen: LOCK DOOR gives "I see nothing to lock the round green door with").
; Otherwise saves the parsed record with #R$7D74 (offset RecWork7, $7955) so the
; player's next line answers it, and prints $ADC0, "{verb} {words} {THING}
; {words} what ?".
; Both end through #R$7D90.
;
; O:A 0
; O:F Z
@label=ReportNoSecondNoun
c$7E4D CALL $7E78             ; words that follow the noun
 $7E50 LD HL,$0000            ; a blank word
 $7E53 PUSH HL       ;
 $7E54 LD A,($B6E8)           ; FirstObject
 $7E57 CALL $71E2             ; HL = its name phrases
 $7E5A PUSH HL       ;
 $7E5B CALL $7E7C             ; words that precede the noun
 $7E5E LD HL,($7958)          ; RecWord1: the verb
 $7E61 PUSH HL       ;
 $7E62 LD HL,$ADE7            ; "I see nothing to ..."
 $7E65 LD A,($7941)           ; RecWork3+1
 $7E68 AND A         ;
 $7E69 JP Z,$7D90             ; nothing could serve: just say so
 $7E6C LD A,($7955)           ; offset of phrase 2
 $7E6F CALL $7D74             ; keep the record for the reply
 $7E72 LD HL,$ADC0            ; "... what ?"
 $7E75 JP $7D90      ;
