; Parse a verb (word classes 4 and 3)
;
; The handler of class 4 (go, run) in ActionTable; class 3 (the other verbs)
; enters at #R$7733. The direction handler (#R$76EC) and "in" (#R$7795) also
; join at #R$7731 when such a word has to be the command word.
; .
; If an AND has saved the parser position (#R$770B, PF_NO_SAVED_POS clear) and
; the line is the player's own, a verb after AND starts a new command: the
; saved position, flags and record are restored and the phrase is closed as if
; THEN had been read (#R$75FA). The verb is read again by the next call of the
; parser, so "take the map and go east" is two commands.
; .
; Otherwise the verb becomes the first command word of the record (#R$7914). A
; second command word is refused with "What ?" (#R$7929). A verb that is go or
; run (PF_PLAIN_VERB clear) first looks ahead past any adverbs: when a direction
; follows, the direction becomes the command word (+0) and go or run the
; second word (+2), the form of the move commands in the command table. If
; none follows the verb is stored as it is.
; .
; BC The word (dictionary offset)
; D Class of this word (#R$7731 sets TOKEN_VERB)
; E Parser flags (see #R$7585)
; IY Phrase record being built
@label=ParseGoVerb
c$772F RES 0,E       ; PF_PLAIN_VERB clear: look ahead for a direction
; This entry point is used by the routines at #R$76EC and #R$7795.
@label=ParseVerbAsCommand
@isub=LD D,TOKEN_VERB
*$7731 LD D,$30      ;
@label=ParseVerb
@isub=BIT PF_NO_SAVED_POS,E
*$7733 BIT 3,E       ; no AND has saved a position?
 $7735 JR NZ,$7755   ;
 $7737 CALL $75F1    ; TestTypedLine
 $773A JR NZ,$7755   ; an order: no restart
 $773C LD HL,($7574) ; SavedHL
 $773F LD ($B6DC),HL ; WordListPtr: back to the word after AND
@isub=LD D,TOKEN_THEN
 $7742 LD D,$B0      ;
 $7744 LD A,($7576)  ; SavedA1
 $7747 LD E,A        ;
 $7748 LD A,($7579)  ; SavedA2
 $774B LD ($B706),A  ; ParserWordCount
 $774E LD IY,($7577) ; SavedIY
 $7752 JP $75FA      ; ParseThen: close the phrase before AND
@label=StoreVerb
*$7755 CALL $785F    ; ClearAllStage
@isub=BIT PF_NEED_COMMAND,E
 $7758 BIT 1,E       ;
 $775A JP Z,$7929    ; a command word already: RejectLine
@isub=BIT PF_PLAIN_VERB,E
 $775D BIT 0,E       ;
 $775F JR Z,$7767    ; go or run
@label=StoreCommandWord
*$7761 CALL $7914    ; StoreFirstWord
 $7764 JP $75B4      ; ParseNextWord
@label=ParseGoDirection
*$7767 PUSH DE       ; look ahead:
 $7768 PUSH BC       ; the verb
 $7769 LD HL,($B6DC) ; WordListPtr
 $776C PUSH HL       ;
*$776D CALL $7873    ; ReadWord
 $7770 CP $00        ;
 $7772 JR Z,$776D    ; skip adverbs (class 0)
@isub=SET PF_PLAIN_VERB,E
 $7774 SET 0,E       ;
@isub=CP TOKEN_DIRECTION
 $7776 CP $20        ;
 $7778 JR Z,$7782    ;
 $777A POP HL        ; not a direction: read it again later
 $777B LD ($B6DC),HL ;
 $777E POP BC        ; BC = the verb
 $777F POP DE        ;
 $7780 JR $7761      ; the verb is the command word
*$7782 CALL $7914    ; the direction (BC) is the command word
 $7785 POP HL        ;
 $7786 POP BC        ; BC = go or run
 $7787 POP HL        ;
@isub=LD L,REC_WORD2
 $7788 LD L,$02      ;
 $778A CALL $7918    ; StoreRecordWord: go or run is the second word
 $778D JP $75B4      ; ParseNextWord
