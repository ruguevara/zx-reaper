; Step to the next entry of the object table
;
; Moves IX on by one (id, record address) entry and loads that entry's record
; address into IY and its id into A. Start a walk with IX = the address before the
; table (ObjectTable - 3, $C060). Works in the alternate registers, so BC, DE
; and HL are kept.
; .
; IX Current entry of ObjectTable (or its base minus 3)
; O:IX Next entry
; O:IY Record of the next object
; O:A Id of the next object
; O:F Z set at the $FF that ends the table
@label=NextObject
c$9B93 EXX           ; alternate registers
@isub=LD DE,ID_ENTRY_SIZE
 $9B94 LD DE,$0003   ;
 $9B97 ADD IX,DE     ;
 $9B99 LD D,(IX+$02) ;
 $9B9C LD E,(IX+$01) ;
 $9B9F PUSH DE       ;
 $9BA0 POP IY        ; IY := record
 $9BA2 LD A,(IX+$00) ;
@isub=CP END_MARK
 $9BA5 CP $FF        ;
 $9BA7 EXX           ;
 $9BA8 RET           ;
