; Find the acting character's order slot, keeping registers
;
; #R$7EFF with HL, DE and BC preserved: only the flag comes back.
;
; O:F Z if Subject ($B6EA) owns an order slot
@label=FindOrderSlotKeep
c$7F10 PUSH HL       ;
 $7F11 PUSH DE       ;
 $7F12 PUSH BC       ;
 $7F13 CALL $7EFF    ;
 $7F16 POP BC        ;
 $7F17 POP DE        ;
 $7F18 POP HL        ;
 $7F19 RET           ;
