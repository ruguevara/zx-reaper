; Pack the flag nibbles of a command record
;
; Takes the top nibbles of the four high bytes of the record's words (verb
; word +1, first preposition +3, second preposition +5, flags word +7) and
; packs them into two bytes: #R$B71D = (nibble of +3 << 4) + nibble of +1,
; #R$B71E = (nibble of +7 << 4) + nibble of +5. Later code tests the single
; bits (for example bit 7 of #R$B71D: the first noun is a location; bit 6 of
; #R$B71E). Meaning of the bits is only partly known.
;
; IX Command table record
; O:A Value stored in #R$B71D
; O:C Nibble of +1
@label=PackCommandFlags
c$70F3 LD A,(IX+$05) ;
 $70F6 RRCA          ;
 $70F7 RRCA          ;
 $70F8 RRCA          ;
 $70F9 RRCA          ;
 $70FA AND $0F       ;
 $70FC LD C,A        ;
 $70FD LD A,(IX+$07) ;
 $7100 AND $F0       ;
 $7102 ADD A,C       ;
 $7103 LD ($B71E),A  ;
 $7106 LD A,(IX+$01) ;
 $7109 RRCA          ;
 $710A RRCA          ;
 $710B RRCA          ;
 $710C RRCA          ;
 $710D AND $0F       ;
 $710F LD C,A        ;
 $7110 LD A,(IX+$03) ;
 $7113 AND $F0       ;
 $7115 ADD A,C       ;
 $7116 LD ($B71D),A  ;
 $7119 RET           ;
