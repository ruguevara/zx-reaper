; Print a message, then a full stop and a new line
;
; Used by the scripted events (#R$A5D1, #R$A657) for sentences whose messages
; have no ending of their own.
;
; HL Message to print
@label=PrintMessageDot
c$97F4 CALL $72DD    ;
@isub=LD A,CHAR_FULLSTOP
 $97F7 LD A,$2E      ;
 $97F9 CALL $858B    ; the full stop
 $97FC JP $8583      ; new line
