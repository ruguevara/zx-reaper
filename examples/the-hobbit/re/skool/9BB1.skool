; Find a location record
;
; Looks the location id up in the table of 80 record addresses (LocationTable
; at $B9E0, 2 bytes each). An id of $50 or more gives A = 0 and leaves IX as it
; was.
; .
; A Location id
; O:IX Address of the location record
; O:A The id (unchanged), or 0 when the id is out of range
; Preserves DE and HL.
@label=FindLocation
@isub=CP LOCATION_COUNT
c$9BB1 CP $50        ;
 $9BB3 JR C,$9BB7    ;
 $9BB5 XOR A         ; out of range: A := 0
 $9BB6 RET           ;
*$9BB7 PUSH DE       ;
 $9BB8 LD DE,$B9E0   ;
 $9BBB PUSH HL       ;
 $9BBC LD L,A        ;
 $9BBD LD H,$00      ;
 $9BBF ADD HL,HL     ;
 $9BC0 ADD HL,DE     ;
 $9BC1 LD E,(HL)     ;
 $9BC2 INC HL        ;
 $9BC3 LD D,(HL)     ;
 $9BC4 PUSH DE       ;
 $9BC5 POP IX        ;
 $9BC7 POP HL        ;
 $9BC8 POP DE        ;
 $9BC9 RET           ;
