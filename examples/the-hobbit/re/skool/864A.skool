; Scroll the input window down one line
;
; Copies character rows 22, 21, 20, 19 and 18 one row down (to 23-19), going
; upward from the bottom. Used when the cursor is moved back past the start of
; the top input line (#R$85F5). The fifth copy takes row 18, the divider row
; below the story window, into row 19; the first line is not cleared here.
; Not executed with the inputs in re/maps.
; .
; Hardware: copies the screen bitmap of rows 18-23.
@label=ScrollInputDown
c$864A PUSH HL
 $864B PUSH DE
 $864C PUSH BC
 $864D PUSH AF
 $864E LD HL,$50C0      ; source: row 22
 $8651 LD DE,$50E0      ; destination: row 23
 $8654 LD A,$05         ; 5 rows
*$8656 PUSH HL
 $8657 PUSH DE
 $8658 LD B,$08         ; 8 pixel lines
*$865A PUSH HL
 $865B PUSH DE
 $865C PUSH BC
@isub=LD BC,ROW_BYTES
 $865D LD BC,$0020      ; one pixel line
 $8660 LDIR
 $8662 POP BC
 $8663 POP DE
 $8664 POP HL
 $8665 INC H
 $8666 INC D
 $8667 DJNZ $865A
 $8669 POP DE
 $866A POP HL
@isub=LD BC,-ROW_BYTES
 $866B LD BC,$FFE0      ; both pointers one character row up
 $866E ADD HL,BC
 $866F EX DE,HL
 $8670 ADD HL,BC
 $8671 EX DE,HL
 $8672 DEC A
 $8673 JR NZ,$8656
 $8675 POP AF
 $8676 POP BC
 $8677 POP DE
 $8678 POP HL
 $8679 RET
