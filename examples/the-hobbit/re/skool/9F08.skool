; Find the exit of the actor's location in a given direction
;
; Walks the exits of the actor's location (#R$9E95) for one whose direction is
; A and whose destination is not 0. BC and IY are kept.
; .
; A Direction (DIR_NORTH to DIR_DOWN)
; O:A The direction when the exit exists, $FF when it does not
; O:IX The exit record (direction, obstacle, destination) when found
@label=FindExitByDirection
c$9F08 PUSH BC       ;
 $9F09 PUSH IY       ;
 $9F0B LD B,A        ; B = direction wanted
 $9F0C CALL $9E95    ; IX = exits - 3
@label=FindExitByDirection_Next
*$9F0F CALL $9B93    ;
 $9F12 JR Z,$9F21    ; no more exits: A = $FF
@isub=LD A,(IX+EXIT_DEST)
 $9F14 LD A,(IX+$02) ;
 $9F17 AND A         ;
 $9F18 JR Z,$9F0F    ; destination 0: not an exit
 $9F1A LD A,(IX+$00) ;
 $9F1D CP B          ;
 $9F1E JP NZ,$9F0F   ;
*$9F21 POP IY        ;
 $9F23 POP BC        ;
 $9F24 RET           ;
