; Match a command table record against the typed phrase
;
; HL points at the three word tokens of the parsed phrase (verb and two
; others, 0 meaning absent) and IY at one record of the command table. The
; verb word must match the record's verb. If it does, #R$B6DF is set to 1
; (the phrase matched in part). The next two words must then match the
; record's two prepositions in order (A=0), or the other way round (A=1).
; Each comparison is made by #R$722E.
;
; HL Parsed phrase (three word tokens)
; IY Command table record
; O:F Z when the record matches
; O:A 0 when the words matched in order, 1 when swapped (valid with Z)
; O:DE, HL, IY Preserved
@label=MatchCommandRecord
c$71F3 PUSH DE       ;
 $71F4 PUSH HL       ;
 $71F5 PUSH IY       ;
 $71F7 CALL $722E    ;
 $71FA JR NZ,$7229   ;
 $71FC LD A,$01      ;
 $71FE LD ($B6DF),A  ; PhraseMatched: the verb matched
 $7201 CALL $722E    ;
 $7204 JR NZ,$720D   ;
 $7206 CALL $722E    ;
 $7209 LD A,$00      ;
 $720B JR Z,$7229    ;
@label=MatchCommandRecord_Swap
*$720D POP IY        ; try the two words swapped
 $720F POP HL        ;
 $7210 PUSH HL       ;
 $7211 PUSH IY       ;
 $7213 LD DE,$0004   ; parsed word 2 against record word 3
 $7216 ADD IY,DE     ;
 $7218 INC HL        ;
 $7219 INC HL        ;
 $721A CALL $722E    ;
 $721D JR NZ,$7229   ;
 $721F LD DE,$FFFC   ; then parsed word 3 against record word 2
 $7222 ADD IY,DE     ;
 $7224 CALL $722E    ;
 $7227 LD A,$01      ;
*$7229 POP IY        ;
 $722B POP HL        ;
 $722C POP DE        ;
 $722D RET           ;
