; Find an object or character record
;
; Looks the id up in ObjectTable (id, record address) with #R$9DBD and puts the
; record address into IX. HL is preserved.
; .
; A Object or character id
; O:IX Address of the record (garbage when the id is not in the table)
; O:A The id, or END_MARK when it is not in the table
; O:F Z set when not found
@label=FindObject
c$9BCA LD IX,$C063   ;
 $9BCE CALL $9DBD    ;
 $9BD1 PUSH HL       ;
 $9BD2 LD L,(IX+$01) ;
 $9BD5 LD H,(IX+$02) ;
 $9BD8 EX (SP),HL    ;
 $9BD9 POP IX        ;
 $9BDB RET           ;
