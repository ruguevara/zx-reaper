; Print a message
;
; The message interpreter. PrintMessage ($72DD) prints the message at HL in the
; story window, or in the input window when RawOutputFlag ($B701) is not 0.
; The parser calls #R$72D3 instead, which first clears ActionPerform ($B6FA)
; when the words are an order being parsed (InputFromOrder, $B71B, not 0), so
; that the message counts as a refusal.
; .
; A message is a list of items, read from IX, up to an ending item (the formats
; are in the notes, "Messages"):
; .
; - bit 7 set: a two-byte word item. D = first byte & $7F, E = second; the high
; nibble of D is the print mode. The modes WORD_END_PLAIN, WORD_END_STOP and
; WORD_END_NEWLINE print the word and end the message (#R$7348); the other
; modes print the word with #R$74C1 and go on.
; - $20-$5F: a literal character (#R$72C3).
; - $60-$7F: a common word (#R$7493).
; - $00-$1F: a control code. Its handler is ControlCodeTable[code]. Codes
; below CODE_FIRST_END are called: the handler returns Z when it has printed
; what it wanted, or NZ with a word token in DE, which is printed here. The
; codes from CODE_FIRST_END on end the message and are jumped to.
; .
; When ActionPerform is 0 (a test pass of a command, see #R$950F) printing a
; message sets ActionAllowed ($B6FB) to 0, so a message printed by a check
; refuses the command. The message is printed in both cases.
; .
; A, DE and IX of the caller are saved in SavedA, SavedDE and SavedIX
; ($70DC-$70E0) and restored by the ending (#R$7348). Words that codes 0, 1, 4
; and 19 ask for are on the stack, below the return address. HL is not kept.
; .
; Hardware: none directly; the characters go to the screen through #R$858B.
;
; HL Address of the message
; A Saved and returned unchanged
; DE Saved and returned unchanged
; IX Saved and returned unchanged
@label=PrintParserMessage
c$72D3 LD A,($B71B)  ; InputFromOrder
 $72D6 AND A         ;
 $72D7 JR Z,$72DD    ;
 $72D9 XOR A         ; an order is being parsed: the message is a refusal
 $72DA LD ($B6FA),A  ; ActionPerform = 0
; This entry point is used by the routines at #R$6C00, #R$72CE, #R$7929,
; #R$83A0, #R$83F5, #R$8498, #R$84CC, #R$855A, #R$8C4B, #R$8C9B, #R$8CA6,
; #R$8CF1, #R$8D33, #R$8D9D, #R$8EEC, #R$8FD6, #R$9034, #R$90D2, #R$90EB,
; #R$9171, #R$924F, #R$939E, #R$93DA, #R$950F, #R$965B, #R$9686, #R$9728,
; #R$97F4, #R$980E, #R$9ACD, #R$9D50, #R$9F94, #R$9FAF, #R$A050, #R$A09D,
; #R$A0C8, #R$A138, #R$A16C, #R$A1E3, #R$A358, #R$A448, #R$A73B and #R$A9D6.
@label=PrintMessage
*$72DD LD ($70DD),DE ; SavedDE
 $72E1 LD ($70E0),IX ; SavedIX
 $72E5 LD ($70DC),A  ; SavedA
 $72E8 LD A,($B6FA)  ; ActionPerform
 $72EB AND A         ;
 $72EC JR NZ,$72F1   ; 1: really doing it
 $72EE LD ($B6FB),A  ; test pass: ActionAllowed = 0 (A is 0)
; This entry point is used by the routine at #R$73E0.
@label=PrintMessageAt
*$72F1 PUSH HL       ;
 $72F2 POP IX        ; IX = the message
@label=PrintMessage_Item
*$72F4 LD A,(IX+$00) ; next item
 $72F7 BIT 7,A       ; a word?
 $72F9 JR Z,$7318    ;
 $72FB AND $7F       ;
 $72FD LD D,A        ; D = print mode and offset bits 8-11
 $72FE LD E,(IX+$01) ; E = offset bits 0-7
 $7301 INC IX        ;
 $7303 AND $F0       ; the print mode
@isub=CP WORD_END_STOP
 $7305 CP $30        ;
 $7307 JR Z,$7348    ; print the word and end the message
@isub=CP WORD_END_PLAIN
 $7309 CP $20        ;
 $730B JR Z,$7348    ;
@isub=CP WORD_END_NEWLINE
 $730D CP $60        ;
 $730F JR Z,$7348    ;
; This entry point is used by the routine at #R$7493.
@label=PrintMessage_Word
*$7311 CALL $74C1    ; print the word (DE)
@label=PrintMessage_Next
*$7314 INC IX        ;
 $7316 JR $72F4      ;
@isub=CP CHAR_SPACE
*$7318 CP $20        ; below $20: a control code
 $731A JR C,$7326    ;
@isub=CP ITEM_COMMON_WORD
 $731C CP $60        ; $60 and up: a common word
 $731E JP NC,$7493   ;
 $7321 CALL $72C3    ; a literal character
 $7324 JR $7314      ;
*$7326 PUSH DE       ;
 $7327 LD E,A        ;
 $7328 LD D,$00      ;
 $732A LD HL,$7295   ; ControlCodeTable
 $732D ADD HL,DE     ;
 $732E ADD HL,DE     ;
 $732F LD E,(HL)     ;
 $7330 INC HL        ;
 $7331 LD D,(HL)     ;
 $7332 EX DE,HL      ; HL = the handler
 $7333 POP DE        ;
@isub=CP CODE_FIRST_END
 $7334 CP $14        ;
 $7336 JR NC,$733F   ; an ending: jump to it
 $7338 CALL $733F    ; any other code: call the handler
 $733B JR Z,$7314    ; it printed what it wanted: next item
 $733D JR $7311      ; NZ: print the word token in DE
*$733F JP (HL)       ;
