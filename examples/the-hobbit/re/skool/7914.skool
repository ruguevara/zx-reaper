; Store a word as the first word of the record
;
; Clears bit 1 of E (no command word is needed any more) and stores BC at +0 of
; the record at IY. #R$7918 stores BC at +L: +0 for the first command word (a
; verb, or the direction in "go north"), +2 for the second (the word "go" when
; a direction follows).
;
; BC Word
; E Parser flags (bit 1 is cleared, #R$7914 only)
; IY Phrase record
; L Offset in the record, 0 or 2 (#R$7918 only)
@label=StoreFirstWord
c$7914 RES 1,E       ;
@isub=LD L,REC_WORD1
 $7916 LD L,$00      ;
; This entry point is used by the routines at #R$76EC and #R$772F.
@label=StoreRecordWord
*$7918 PUSH DE       ; keep DE
 $7919 PUSH IY       ;
 $791B POP DE        ;
 $791C LD H,$00      ; HL = L
 $791E ADD HL,DE     ; HL = IY + L
 $791F LD (HL),C     ; word, low byte first
 $7920 INC HL        ;
 $7921 LD (HL),B     ;
 $7922 POP DE        ;
 $7923 RET           ;
