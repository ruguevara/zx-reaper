; Death scene, then restart the room or end the game
@label=PlayDeath
@isub=LD A,FLASH_START_ATTR
c$8C01 LD A,$47          ; first colour: bright white ink, black paper
@label=PlayDeath_Round
*$8C03 LD HL,$5800       ; flood the top two thirds of the screen attributes ...
@isub=LD DE,ATTRS+1
 $8C06 LD DE,$5801 ;
@isub=LD BC,ROOM_ATTRS_SIZE-1
 $8C09 LD BC,$01FF ;
 $8C0C LD (HL),A         ; ... with this colour
 $8C0D LDIR ;
 $8C0F LD E,A            ; E = colour
 $8C10 CPL ;
@isub=AND INK_MASK
 $8C11 AND $07 ;
 $8C13 RLCA ;
 $8C14 RLCA ;
 $8C15 RLCA ;
 $8C16 OR $07            ; D = ((7 - ink) * 8) + 7: delay, grows as the ink falls
 $8C18 LD D,A ;
 $8C19 LD C,E            ; C = colour rotated right 3 times: toggles in this round
 $8C1A RRC C ;
 $8C1C RRC C ;
 $8C1E RRC C ;
 $8C20 OR $10           ; result unused: A is cleared below
 $8C22 XOR A             ; speaker off, border black
@label=PlayDeath_Buzz
@isub=OUT (ULA_PORT),A
*$8C23 OUT ($FE),A ;
@isub=XOR BEEPER_BITS
 $8C25 XOR $18 ;
 $8C27 LD B,D ;
*$8C28 DJNZ $8C28 ;
 $8C2A DEC C ;
 $8C2B JR NZ,$8C23 ;
 $8C2D LD A,E            ; next colour (ink - 1)
 $8C2E DEC A ;
@isub=CP FLASH_END_ATTR
 $8C2F CP $3F            ; ink 0 done?
 $8C31 JR NZ,$8C03 ;
@label=RestartAfterDeath
 $8C33 LD HL,$85CC       ; lives in reserve
 $8C36 LD A,(HL) ;
 $8C37 OR A ;
 $8C38 JP Z,$8C4A        ; none left: game over
 $8C3B DEC (HL)          ; one life used
 $8C3C LD HL,$85D7       ; state saved at room entry ...
 $8C3F LD DE,$85CF       ; ... back to Willy state ($85CF-$85D5)
@isub=LD BC,WILLY_STATE_SIZE
 $8C42 LD BC,$0007 ;
 $8C45 LDIR ;
 $8C47 JP $8912          ; enter the room again
