; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $D580 DEFM "         Ballroom West          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $D5A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $D5A9 DEFB $32,$AA,$A8,$AD,$AF,$20,$AA,$55,$55 ; tile 1 (floor): red on yellow
 $D5B2 DEFB $23,$11,$22,$88,$11,$44,$88,$22,$44 ; tile 2 (wall): magenta on green
 $D5BB DEFB $42,$28,$54,$AA,$54,$A8,$54,$14,$2E ; tile 3 (nasty): bright red on black [not used in this room]
 $D5C4 DEFB $07,$C0,$C0,$30,$B0,$0C,$0C,$03,$0B ; tile 4 (ramp): white on black
 $D5CD DEFB $46,$FF,$FF,$FF,$AA,$55,$18,$18,$18 ; tile 5 (conveyor): bright yellow on black
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $D5D6 DEFB $01,$B0,$5F,$0C ; direction 1 (right), address $5FB0 = row 13 column 16, 12 cells
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $D5DA DEFB $00,$A3,$5F,$04 ; direction 0 (rises to the left), lowest cell $5FA3 = row 13 column 3, 4 cells
; Border colour; then $DF-$E0, not read by any code.
 $D5DE DEFB $01,$00,$00 ; border blue (1); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $D5E1 DEFB $04,$04,$AE,$AE,$A2,$42,$42,$EE ; item graphic
; Exits: room numbers left, right, up, down.
 $D5E9 DEFB $16,$14,$1B,$00 ; left 22, right 20, up 27, down 0
; Three bytes not read by any code.
 $D5ED DEFB $00,$00,$00 ; unused
