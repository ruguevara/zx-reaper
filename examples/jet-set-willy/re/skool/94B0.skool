; Leave the room through the top: enter the room above at its bottom
;
; Makes the room above (byte $EB of the room, $80EB) the current room and
; puts Willy at the bottom: Willy's attribute address (#R$85D3/#R$85D4) gets
; row 5 of the lower half (row 13 of the room, attribute page $5D), the
; column is kept, Willy's Y (#R$85CF) becomes $D0 (twice the pixel row, 104)
; and the jump/fall state #R$85D1 is cleared. Pops the caller's return
; address and jumps to #R$8912, so it never returns.
; .
; Reached when Willy's Y wraps past the top (from #R$8DD3 when Y >= $F0
; after moving up, and from #R$89AD when Y >= $E1).
@label=ExitRoomUp
c$94B0 LD A,($80EB)  ;
 $94B3 LD ($8420),A  ; new current room
 $94B6 LD A,($85D3)  ;
@isub=AND COLUMN_MASK
 $94B9 AND $1F       ; keep the column, clear the row bits
@isub=ADD A,SCREEN_COLS*(Y_LOW_FLOOR/Y_ROW_STEP-CELL_HEIGHT)
 $94BB ADD A,$A0     ; row bits 101 = row 5
 $94BD LD ($85D3),A  ;
@isub=LD A,1+(SCREEN_ATTRS_BUF>>8)
 $94C0 LD A,$5D      ; attribute page of the lower half
@isub=LD (WillyAttrAddr+1),A
 $94C2 LD ($85D4),A  ;
@isub=LD A,Y_LOW_FLOOR
 $94C5 LD A,$D0      ; Y = 104 pixel rows * 2
 $94C7 LD ($85CF),A  ;
 $94CA XOR A         ;
 $94CB LD ($85D1),A  ; jump/fall state 0 (TODO: confirm meaning of #R$85D1)
 $94CE POP HL        ; drop the return address
 $94CF JP $8912      ; load the new room
