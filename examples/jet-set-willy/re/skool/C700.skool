; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $C780 DEFM "         Cuckoo's Nest          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $C7A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $C7A9 DEFB $04,$04,$03,$C9,$D8,$30,$36,$23,$01 ; tile 1 (floor): green on black
 $C7B2 DEFB $16,$FF,$60,$0E,$F0,$03,$3C,$C7,$38 ; tile 2 (wall): yellow on red
 $C7BB DEFB $06,$C2,$34,$0B,$44,$88,$0B,$30,$08 ; tile 3 (nasty): yellow on black
 $C7C4 DEFB $07,$03,$00,$0C,$00,$30,$00,$C0,$00 ; tile 4 (ramp): white on black
 $C7CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $C7D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $C7DA DEFB $01,$8D,$5F,$02 ; direction 1 (rises to the right), lowest cell $5F8D = row 12 column 13, 2 cells
; Border colour; then $DF-$E0, not read by any code.
 $C7DE DEFB $01,$00,$00 ; border blue (1); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $C7E1 DEFB $20,$18,$A9,$DB,$7E,$7E,$3C,$5A ; item graphic
; Exits: room numbers left, right, up, down.
 $C7E9 DEFB $08,$00,$00,$02 ; left 8, right 0, up 0, down 2
; Three bytes not read by any code.
 $C7ED DEFB $00,$00,$00 ; unused
