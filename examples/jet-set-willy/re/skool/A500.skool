; Item table, second half: cell position of each item
;
; Byte for each item index (see #R$A400, whose entry has the full format):
; bits 0-4 column (0-31), bits 5-7 row inside the half of the room chosen by
; bit 7 of #R$A400 + index. Also the low byte of the item's address in the
; attribute buffer (page $5C or $5D) and in the screen buffer (page $60 or
; $68). The first $AD bytes are unused zeros (items start at #R$A3FF).
; Never written while the game runs.
@label=ItemPositionTable
b$A500 DEFS $AD
 $A5AD DEFB $19,$2A,$34,$38,$C9,$B3,$7B,$46,$1F,$19,$1C,$16,$64,$99,$9F,$9F
 $A5BD DEFB $9F,$1A,$CD,$B6,$3C,$D0,$A6,$DD,$37,$B6,$7A,$22,$43,$A8,$06,$66
 $A5CD DEFB $C7,$C9,$22,$F3,$B3,$70,$96,$65,$EF,$6A,$9D,$49,$91,$92,$94,$96
 $A5DD DEFB $97,$5A,$8B,$99,$9B,$7A,$C2,$25,$92,$62,$61,$44,$67,$9C,$E4,$FC
 $A5ED DEFB $42,$5C,$A4,$93,$94,$95,$96,$97,$98,$99,$9A,$9B,$9C,$9D,$9E,$16
 $A5FD DEFB $3A,$C8,$B7
