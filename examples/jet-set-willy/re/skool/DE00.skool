; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $DE80 DEFM "       The Banyan Tree          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $DEA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $DEA9 DEFB $48,$00,$A2,$00,$00,$00,$46,$00,$93 ; tile 1 (floor): bright black on blue
 $DEB2 DEFB $16,$4A,$29,$25,$49,$92,$A4,$25,$94 ; tile 2 (wall): yellow on red
 $DEBB DEFB $0E,$A5,$5A,$A5,$5A,$A5,$5A,$A5,$5A ; tile 3 (nasty): yellow on blue [not used in this room]
