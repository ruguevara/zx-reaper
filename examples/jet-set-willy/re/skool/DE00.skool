 $DECD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $DED6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $DEDA DEFB $01,$64,$5F,$08 ; direction 1 (rises to the right), lowest cell $5F64 = row 11 column 4, 8 cells
; Border colour; then $DF-$E0, not read by any code.
 $DEDE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
