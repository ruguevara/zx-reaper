; Read Willy's input: landing, conveyor, keys, move state, jump start
;
; Willy stands on ground or holds a rope: land, collect the key bits, update
; the move state and start a jump if asked. Reached by JP from the ground test
; and from the rope test in #R$8DD3. The key bits go into E (0 = pressed; bits
; 0, 2, 4 = right, bits 1, 3, 5 = left), starting as $FF.
; .
; Hardware: reads the keyboard (ports $FBFE, $DFFE, $EFFE, $F7FE, $7EFE...)
; and the Kempston port when #R$85CE is set.
@label=MoveWilly_Supported
c$8ED4 LD E,$FF      ; E = key bits, nothing pressed
 $8ED6 LD A,($85D6)  ; rope variable
 $8ED9 DEC A         ;
 $8EDA BIT 7,A       ;
 $8EDC JR Z,$8EFA    ; holding a rope: skip landing and conveyor
 $8EDE LD A,($85D1)  ; air state
@isub=CP AIR_FATAL_FALL
 $8EE1 CP $0C        ;
 $8EE3 JP NC,$90B7   ; landed from a fall of state $0C or more: killed
 $8EE6 XOR A         ;
 $8EE7 LD ($85D1),A  ; state 0: standing
 $8EEA LD A,($80CD)  ; conveyor attribute
 $8EED CP (HL)       ; left cell under his feet (HL) is conveyor?
 $8EEE JR Z,$8EF4    ;
 $8EF0 INC HL        ;
 $8EF1 CP (HL)       ; right cell under his feet is conveyor?
 $8EF2 JR NZ,$8EFA   ;
@label=MoveWilly_Conveyor
*$8EF4 LD A,($80D6)  ; conveyor direction 0 or 1
 $8EF7 SUB $03       ; direction 0: $FD (left bit clear), 1: $FE (right bit clear)
 $8EF9 LD E,A        ; conveyor as a pressed key
@label=MoveWilly_Keys
@isub=LD BC,KEYROW_P_Y
*$8EFA LD BC,$DFFE   ; P O I U Y: right left right left right
 $8EFD IN A,(C)      ;
@isub=AND KEYS_MASK
 $8EFF AND $1F       ;
 $8F01 OR $20        ; bit 5 is not a key here
 $8F03 AND E         ; combine with E
 $8F04 LD E,A        ;
 $8F05 LD A,($85DF)  ; ending stage
@isub=AND 1<<ENDING_AUTORUN_BIT
 $8F08 AND $02       ; stages 2 and 3: bit 1
 $8F0A RRCA          ; to bit 0
 $8F0B XOR E         ; flips the P bit: the right key is forced on in the ending run
 $8F0C LD E,A        ;
@isub=LD BC,KEYROW_Q_T
 $8F0D LD BC,$FBFE   ; Q W E R T: shifted to bits 1-5: left right left right left
 $8F10 IN A,(C)      ;
@isub=AND KEYS_MASK
 $8F12 AND $1F       ;
 $8F14 RLC A         ; bit 0 is left free
 $8F16 OR $01        ;
 $8F18 AND E         ;
 $8F19 LD E,A        ;
@isub=LD B,KEYROWS_5_6_HI
 $8F1A LD B,$E7      ; half rows 1-5 and 6-0 together
 $8F1C IN A,(C)      ;
 $8F1E RRCA          ; keys 5 and 6 (bit 4) to bit 3: left
 $8F1F OR $F7        ; keep only bit 3
 $8F21 AND E         ;
 $8F22 LD E,A        ;
@isub=LD B,KEYROW_0_9>>8
 $8F23 LD B,$EF      ; 0 9 8 7 6
 $8F25 IN A,(C)      ; key 8 (bit 2): right
 $8F27 OR $FB        ; keep only bit 2
 $8F29 AND E         ;
 $8F2A LD E,A        ;
 $8F2B IN A,(C)      ; same row again
 $8F2D RRCA          ; key 7 (bit 3) to bit 2: right
 $8F2E OR $FB        ; keep only bit 2
 $8F30 AND E         ;
 $8F31 LD E,A        ;
 $8F32 LD A,($85CE)  ; Kempston joystick present?
 $8F35 OR A          ;
 $8F36 JR Z,$8F42    ; no
@isub=LD BC,KEMPSTON_PORT
 $8F38 LD BC,$001F   ;
 $8F3B IN A,(C)      ; bit 0 right, bit 1 left, 1 = pressed
@isub=AND KEMPSTON_LR_MASK
 $8F3D AND $03       ;
 $8F3F CPL           ; 0 = pressed, as the keys
 $8F40 AND E         ;
 $8F41 LD E,A        ;
@label=MoveWilly_State
*$8F42 LD C,$00      ; C = row of the state table: no direction
 $8F44 LD A,E        ; left bits
@isub=AND KEYBITS_LEFT
 $8F45 AND $2A       ;
@isub=CP KEYBITS_LEFT
 $8F47 CP $2A        ;
 $8F49 JR Z,$8F51    ; no left key
@isub=LD C,STATE_ROW_LEFT
 $8F4B LD C,$04      ; left row
 $8F4D XOR A         ; a direction key resets the idle counter
 $8F4E LD ($85E0),A  ; clear the idle counter
*$8F51 LD A,E        ; right bits
@isub=AND KEYBITS_RIGHT
 $8F52 AND $15       ;
@isub=CP KEYBITS_RIGHT
 $8F54 CP $15        ;
 $8F56 JR Z,$8F5E    ; no right key
@isub=SET STATE_ROW_RIGHT_BIT,C
 $8F58 SET 3,C       ; adds 8: right row (12 when both)
 $8F5A XOR A         ;
 $8F5B LD ($85E0),A  ; clear the idle counter
*$8F5E LD A,($85D0)  ; old move state
 $8F61 ADD A,C       ; index = old state + key row
 $8F62 LD C,A        ;
 $8F63 LD B,$00      ;
@isub=LD HL,MoveStateTable
 $8F65 LD HL,$8421   ;
 $8F68 ADD HL,BC     ;
 $8F69 LD A,(HL)     ; new move state
 $8F6A LD ($85D0),A  ;
@label=MoveWilly_JumpKeys
@isub=LD BC,KEYROWS_BOTTOM
 $8F6D LD BC,$7EFE   ; half rows CAPS SHIFT-V and B-SPACE
 $8F70 IN A,(C)      ;
@isub=AND KEYS_MASK
 $8F72 AND $1F       ;
@isub=CP NO_KEYS
 $8F74 CP $1F        ;
 $8F76 JR NZ,$8F8F   ; any of them: jump
@isub=LD B,KEYROW_0_9>>8
 $8F78 LD B,$EF      ; key 0
 $8F7A IN A,(C)      ;
 $8F7C BIT 0,A       ; key 0 is bit 0
 $8F7E JR Z,$8F8F    ; pressed: jump
 $8F80 LD A,($85CE)  ; Kempston joystick present?
 $8F83 OR A          ;
 $8F84 JR Z,$8FBC    ; no joystick: no jump key
@isub=LD BC,KEMPSTON_PORT
 $8F86 LD BC,$001F   ;
 $8F89 IN A,(C)      ;
@isub=BIT KEMPSTON_FIRE_BIT,A
 $8F8B BIT 4,A       ;
 $8F8D JR Z,$8FBC    ; fire not pressed: no jump
@label=MoveWilly_Jump
*$8F8F LD A,($85DF)  ; ending stage
@isub=BIT ENDING_AUTORUN_BIT,A
 $8F92 BIT 1,A       ; stage 2 or 3: jump ignored
 $8F94 JR NZ,$8FBC   ;
 $8F96 XOR A         ;
 $8F97 LD ($85D5),A  ; jump step 0
 $8F9A LD ($85E0),A  ; clear the idle counter
 $8F9D INC A         ;
 $8F9E LD ($85D1),A  ; air state 1: jumping
 $8FA1 LD A,($85D6)  ; rope variable
 $8FA4 DEC A         ;
 $8FA5 BIT 7,A       ;
 $8FA7 JR NZ,$8FBC   ; no rope held: walk in this pass
@isub=LD A,ROPE_LET_GO
 $8FA9 LD A,$F0      ; jumping off a rope: let go, cannot grab for 16 passes
 $8FAB LD ($85D6),A  ;
 $8FAE LD A,($85CF)  ; Y index
@isub=AND Y_ROW_MASK
 $8FB1 AND $F0       ; to a row boundary
 $8FB3 LD ($85CF),A  ;
 $8FB6 LD HL,$85D0   ; move state
@isub=SET MOVE_WALK_BIT,(HL)
 $8FB9 SET 1,(HL)    ; he leaves the rope walking in the direction he faces
 $8FBB RET           ;
