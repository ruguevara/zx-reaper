; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $C680 DEFM "        Entrance to Hades       "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $C6A0 DEFB $34,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): green on yellow
 $C6A9 DEFB $A3,$A0,$14,$82,$50,$0A,$41,$28,$05 ; tile 1 (floor): magenta on green, flashing
 $C6B2 DEFB $63,$BB,$BB,$38,$BB,$BB,$BB,$83,$BB ; tile 2 (wall): bright magenta on green
 $C6BB DEFB $32,$BF,$5C,$58,$30,$28,$58,$48,$30 ; tile 3 (nasty): red on yellow
 $C6C4 DEFB $07,$40,$40,$10,$10,$04,$04,$01,$01 ; tile 4 (ramp): white on black [not used in this room]
 $C6CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $C6D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $C6DA DEFB $00,$C7,$5F,$00 ; no ramp (length 0); direction and address are leftovers
; Border colour; then $DF-$E0, not read by any code.
 $C6DE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $C6E1 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; item graphic (all zeros: blank)
; Exits: room numbers left, right, up, down.
 $C6E9 DEFB $0E,$05,$00,$00 ; left 14, right 5, up 0, down 0
; Three bytes not read by any code.
 $C6ED DEFB $00,$00,$00 ; unused
