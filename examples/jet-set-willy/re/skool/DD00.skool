; Room 29 ($1D): The Nightmare Room
;
; Format: see #R$C000.
; .
; Border: red (2). Conveyor: moves Willy left, 1 cells from row 7 column 27.
; Ramp: 3 cells from row 14 column 9 up to row 12 column 7, rising to the
; left.
; .
; Items (from the item table at #R$A400): 1, at row 9 column 26.
; .
; Exits: left Room 30 (The Banyan Tree, #R$DE00); right Room 28 (First
; Landing, #R$DC00); up Room 0 (The Off Licence, #R$C000); down Room 0 (The
; Off Licence, #R$C000).
; .
; Entities: slot 0: definition $46 (at $A230) start $88; slot 1: definition
; $47 (at $A238) start $CB; slot 2: definition $48 (at $A240) start $4E; slot
; 3: definition $49 (at $A248) start $D1; slot 4: definition $46 (at $A230)
; start $94; slot 5: definition $47 (at $A238) start $97; slot 6: definition
; $48 (at $A240) start $9C. List ends at slot 7 ($FF).
; .
; Odd: tile 5 (conveyor) has attribute $A5, which first occurs at tile-area
; offset 11 (inside tile 1), so #R$8D33 draws it with the 8 bytes after that
; offset instead of its own pixels (observed in the $7000 buffer).
@label=RoomNightmareRoom
b$DD00 DEFB $00,$00,$00,$00,$00,$00,$00,$0A ; row 0: ..............................##
 $DD08 DEFB $00,$00,$00,$00,$00,$00,$00,$0A ; row 1: ..............................##
 $DD10 DEFB $00,$00,$00,$00,$00,$00,$00,$0A ; row 2: ..............................##
 $DD18 DEFB $00,$00,$00,$00,$00,$00,$00,$0A ; row 3: ..............................##
 $DD20 DEFB $00,$00,$00,$00,$00,$00,$00,$0A ; row 4: ..............................##
 $DD28 DEFB $00,$00,$04,$00,$40,$04,$00,$0A ; row 5: ..........-.....-.....-.......##
 $DD30 DEFB $00,$00,$00,$10,$00,$00,$00,$0A ; row 6: .............-................##
 $DD38 DEFB $00,$01,$00,$00,$01,$00,$00,$0A ; row 7: .......-...........-..........##
 $DD40 DEFB $00,$00,$04,$00,$00,$04,$00,$0A ; row 8: ..........-...........-.......##
 $DD48 DEFB $00,$00,$00,$10,$00,$00,$00,$0A ; row 9: .............-................##
 $DD50 DEFB $00,$00,$00,$00,$01,$00,$04,$0A ; row 10: ...................-......-...##
 $DD58 DEFB $00,$00,$04,$00,$00,$04,$00,$0A ; row 11: ..........-...........-.......##
 $DD60 DEFB $AA,$A8,$00,$10,$00,$00,$00,$0A ; row 12: #######......-................##
 $DD68 DEFB $AA,$AA,$00,$00,$00,$00,$00,$00 ; row 13: ########........................
 $DD70 DEFB $AA,$AA,$80,$00,$00,$00,$00,$00 ; row 14: #########.......................
 $DD78 DEFB $AA,$AA,$AA,$AA,$AA,$AA,$AA,$AA ; row 15: ################################
; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $DD80 DEFM "       The Nightmare Room       "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $DDA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $DDA9 DEFB $44,$FF,$A5,$52,$24,$42,$22,$40,$04 ; tile 1 (floor): bright green on black
 $DDB2 DEFB $33,$00,$2A,$54,$00,$00,$A2,$45,$00 ; tile 2 (wall): magenta on yellow
 $DDBB DEFB $45,$42,$99,$66,$A1,$9F,$81,$66,$5A ; tile 3 (nasty): bright cyan on black [not used in this room]
 $DDC4 DEFB $07,$80,$C0,$A0,$F0,$F8,$5C,$BA,$02 ; tile 4 (ramp): white on black
 $DDCD DEFB $A5,$FF,$5A,$FF,$FF,$AA,$55,$AA,$55 ; tile 5 (conveyor): cyan on green, flashing
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $DDD6 DEFB $00,$FB,$5E,$01 ; direction 0 (left), address $5EFB = row 7 column 27, 1 cells
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $DDDA DEFB $00,$C9,$5F,$03 ; direction 0 (rises to the left), lowest cell $5FC9 = row 14 column 9, 3 cells
; Border colour; then $DF-$E0, not read by any code.
 $DDDE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $DDE1 DEFB $AC,$AE,$01,$AD,$AD,$02,$AC,$58 ; item graphic
; Exits: room numbers left, right, up, down.
 $DDE9 DEFB $1E,$1C,$00,$00 ; left 30, right 28, up 0, down 0
; Three bytes not read by any code.
 $DDED DEFB $00,$00,$00 ; unused
; Entity slots: definition index, start byte (see #R$C000).
 $DDF0 DEFB $46,$88 ; definition $46, start $88 (column 8)
 $DDF2 DEFB $47,$CB ; definition $47, start $CB (column 11)
 $DDF4 DEFB $48,$4E ; definition $48, start $4E (column 14)
 $DDF6 DEFB $49,$D1 ; definition $49, start $D1 (column 17)
 $DDF8 DEFB $46,$94 ; definition $46, start $94 (column 20)
 $DDFA DEFB $47,$97 ; definition $47, start $97 (column 23)
 $DDFC DEFB $48,$9C ; definition $48, start $9C (column 28)
 $DDFE DEFB $FF,$00 ; end of list
