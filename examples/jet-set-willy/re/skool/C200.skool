; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $C280 DEFM "       Under the MegaTree       "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $C2A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $C2A9 DEFB $44,$D7,$B3,$75,$6D,$5C,$18,$08,$04 ; tile 1 (floor): bright green on black
 $C2B2 DEFB $42,$BD,$AA,$5D,$A2,$F3,$0A,$06,$01 ; tile 2 (wall): bright red on black
 $C2BB DEFB $46,$49,$6A,$3B,$3A,$FC,$1E,$6B,$E8 ; tile 3 (nasty): bright yellow on black
 $C2C4 DEFB $FF,$00,$00,$00,$FF,$00,$00,$00,$00 ; tile 4 (ramp): bright white on white, flashing [not used in this room]
 $C2CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $C2D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $C2DA DEFB $00,$00,$00,$00 ; no ramp (length 0)
; Border colour; then $DF-$E0, not read by any code.
 $C2DE DEFB $06,$80,$A0 ; border yellow (6); $DF-$E0 = $80,$A0
; Item graphic: 8 pixel rows shared by all items of the room.
 $C2E1 DEFB $81,$42,$24,$18,$3C,$18,$3C,$C3 ; item graphic
; Exits: room numbers left, right, up, down.
 $C2E9 DEFB $03,$01,$00,$00 ; left 3, right 1, up 0, down 0
; Three bytes not read by any code.
 $C2ED DEFB $00,$00,$00 ; unused
