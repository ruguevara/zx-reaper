; Expand the room layout into the attribute buffer
;
; Builds the attributes of the empty room (no sprites) at $5E00, 512 bytes
; for the 16 rows of 32 cells of the playing area:
; .
; 1. Each of the 128 layout bytes at $8000 holds 4 cells of 2 bits, first cell
; in bits 7-6; every cell is replaced by its tile's attribute through #R$8DC0.
; 2. If the conveyor length ($80D9) is not 0, that many cells starting at the
; conveyor address ($80D7, an address in the $5E00 buffer) get the conveyor
; tile's attribute (tile 5, $80CD).
; 3. If the ramp length ($80DD) is not 0, that many cells get the ramp tile's
; attribute (tile 4, $80C4), starting at the ramp address ($80DB) and moving
; up one row per cell, one column left when ramp direction bit 0 ($80DA) is
; 0 (step -33) and one column right when it is 1 (step -31).
; .
; Observed: a Python model of these three steps reproduces $5E00-$5FFF of a
; snapshot taken in the Bathroom exactly (that room has a conveyor and a
; ramp going right).
; .
; Hardware: none (memory only).
;
; O:A Corrupted (HL, IX, B, DE also change)
@label=ExpandRoomLayout
c$8D6B LD HL,$8000   ;
 $8D6E LD IX,$5E00   ;
@label=ExpandRoomLayout_Byte
*$8D72 LD A,(HL)     ;
 $8D73 RLCA          ;
 $8D74 RLCA          ;
 $8D75 CALL $8DC0    ;
 $8D78 LD A,(HL)     ;
 $8D79 RRCA          ;
 $8D7A RRCA          ;
 $8D7B RRCA          ;
 $8D7C RRCA          ;
 $8D7D CALL $8DC0    ;
 $8D80 LD A,(HL)     ;
 $8D81 RRCA          ;
 $8D82 RRCA          ;
 $8D83 CALL $8DC0    ;
 $8D86 LD A,(HL)     ;
 $8D87 CALL $8DC0    ;
 $8D8A INC HL        ;
 $8D8B LD A,L        ; until HL reaches $8080
@isub=AND ROOM_LAYOUT_SIZE
 $8D8C AND $80       ;
 $8D8E JR Z,$8D72    ;
 $8D90 LD A,($80D9)  ;
 $8D93 OR A          ;
 $8D94 JR Z,$8DA1    ;
 $8D96 LD HL,($80D7) ;
 $8D99 LD B,A        ;
 $8D9A LD A,($80CD)  ;
*$8D9D LD (HL),A     ;
 $8D9E INC HL        ;
 $8D9F DJNZ $8D9D    ;
*$8DA1 LD A,($80DD)  ;
 $8DA4 OR A          ;
 $8DA5 RET Z         ;
 $8DA6 LD HL,($80DB) ;
 $8DA9 LD A,($80DA)  ;
 $8DAC AND $01       ;
 $8DAE RLCA          ;
@isub=ADD A,(-SCREEN_COLS-1)&$FF
 $8DAF ADD A,$DF     ; E = $DF or $E1: step -33 or -31 (D = $FF)
 $8DB1 LD E,A        ;
 $8DB2 LD D,$FF      ;
 $8DB4 LD A,($80DD)  ;
 $8DB7 LD B,A        ;
 $8DB8 LD A,($80C4)  ;
*$8DBB LD (HL),A     ;
 $8DBC ADD HL,DE     ;
 $8DBD DJNZ $8DBB    ;
 $8DBF RET           ;
