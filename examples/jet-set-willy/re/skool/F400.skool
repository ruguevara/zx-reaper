; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $F480 DEFM "         Back Stairway          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $F4A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $F4A9 DEFB $43,$FF,$44,$44,$FF,$11,$11,$FF,$00 ; tile 1 (floor): bright magenta on black
 $F4B2 DEFB $1E,$15,$F1,$8F,$A8,$8A,$F8,$1F,$15 ; tile 2 (wall): yellow on magenta
 $F4BB DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 3 (nasty): bright white on white, flashing [not used in this room]
 $F4C4 DEFB $47,$03,$01,$0C,$04,$30,$10,$C0,$40 ; tile 4 (ramp): bright white on black
 $F4CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $F4D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $F4DA DEFB $01,$E2,$5F,$10 ; direction 1 (rises to the right), lowest cell $5FE2 = row 15 column 2, 16 cells
; Border colour; then $DF-$E0, not read by any code.
 $F4DE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $F4E1 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; item graphic (all zeros: blank)
