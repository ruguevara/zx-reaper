; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $D7A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $D7A9 DEFB $04,$FE,$01,$7D,$85,$81,$81,$81,$01 ; tile 1 (floor): green on black
 $D7B2 DEFB $4D,$42,$A5,$5A,$24,$24,$5A,$A5,$42 ; tile 2 (wall): bright cyan on blue
