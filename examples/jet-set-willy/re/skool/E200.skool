; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $E280 DEFM "          Top Landing           "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $E2A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $E2A9 DEFB $06,$FF,$AA,$55,$FF,$00,$00,$00,$00 ; tile 1 (floor): yellow on black
 $E2B2 DEFB $1A,$69,$90,$90,$69,$96,$69,$69,$96 ; tile 2 (wall): red on magenta
 $E2BB DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 3 (nasty): bright white on white, flashing [not used in this room]
 $E2C4 DEFB $07,$07,$02,$3C,$08,$70,$20,$C0,$80 ; tile 4 (ramp): white on black
 $E2CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $E2D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $E2DA DEFB $01,$71,$5F,$07 ; direction 1 (rises to the right), lowest cell $5F71 = row 11 column 17, 7 cells
; Border colour; then $DF-$E0, not read by any code.
 $E2DE DEFB $01,$00,$00 ; border blue (1); $DF-$E0 = $00,$00
