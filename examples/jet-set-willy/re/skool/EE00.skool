; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $EE80 DEFM "           Tree Root            "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $EEA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $EEA9 DEFB $06,$FF,$FF,$00,$00,$00,$00,$00,$00 ; tile 1 (floor): yellow on black
 $EEB2 DEFB $0A,$66,$99,$24,$24,$77,$88,$8D,$72 ; tile 2 (wall): red on blue
 $EEBB DEFB $02,$1C,$2A,$5F,$7D,$BE,$FE,$D2,$7C ; tile 3 (nasty): red on black
 $EEC4 DEFB $43,$03,$02,$0D,$02,$31,$08,$D5,$22 ; tile 4 (ramp): bright magenta on black
 $EECD DEFB $04,$EE,$AA,$38,$FF,$FF,$10,$10,$38 ; tile 5 (conveyor): green on black
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $EED6 DEFB $00,$40,$5F,$0D ; direction 0 (left), address $5F40 = row 10 column 0, 13 cells
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $EEDA DEFB $01,$D8,$5F,$06 ; direction 1 (rises to the right), lowest cell $5FD8 = row 14 column 24, 6 cells
; Border colour; then $DF-$E0, not read by any code.
 $EEDE DEFB $01,$00,$00 ; border blue (1); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $EEE1 DEFB $02,$1D,$22,$5E,$BE,$7C,$38,$10 ; item graphic
; Exits: room numbers left, right, up, down.
 $EEE9 DEFB $2D,$2F,$03,$00 ; left 45, right 47, up 3, down 0
; Three bytes not read by any code.
 $EEED DEFB $00,$00,$00 ; unused
; Entity slots: definition index, start byte (see #R$C000).
 $EEF0 DEFB $1E,$84 ; definition $1E, start $84 (column 4)
 $EEF2 DEFB $28,$0D ; definition $28, start $0D (column 13)
 $EEF4 DEFB $23,$13 ; definition $23, start $13 (column 19)
