; Sprite: Willy facing right, walk frame 3
;
; One 16x16 sprite of 32 bytes: 16 pixel rows of 2 bytes (left byte, right byte; bit 7 = leftmost pixel), drawn with
; #R$9456. Willy walking to the right (observed: key P gives $85D0 = 2, bit 0 clear), walk frame 3. #R$9637 draws Willy
; from $9D00 + 128*(bit 0 of #R$85D0) + 32*(#R$85D2 AND 3); the lives indicator #R$898B shows frames 0-3 in turn (frame
; counter #R$85E1).
@label=SpriteWillyRight3
b$9D60 DEFB $00,$F0
 $9D62 DEFB $00,$F0
 $9D64 DEFB $01,$F8
 $9D66 DEFB $00,$D0
 $9D68 DEFB $00,$F8
 $9D6A DEFB $00,$F0
 $9D6C DEFB $00,$60
 $9D6E DEFB $00,$F0
 $9D70 DEFB $01,$F8
 $9D72 DEFB $03,$FC
 $9D74 DEFB $07,$FE
 $9D76 DEFB $06,$F6
 $9D78 DEFB $00,$F8
 $9D7A DEFB $01,$DA
 $9D7C DEFB $03,$0E
