 $F718 DEFB $00,$00,$00,$00,$A0,$40,$00,$15 ; row 3: ................##..-........---
 $F720 DEFB $00,$00,$04,$00,$A0,$40,$00,$00 ; row 4: ..........-.....##..-...........
 $F728 DEFB $00,$00,$00,$00,$A0,$40,$00,$00 ; row 5: ................##..-...........
 $F730 DEFB $00,$00,$00,$10,$A0,$40,$00,$00 ; row 6: .............-..##..-...........
 $F738 DEFB $00,$00,$00,$00,$A0,$40,$00,$00 ; row 7: ................##..-...........
