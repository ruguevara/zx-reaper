; Room 26 ($1A): East Wall Base
;
; Format: see #R$C000.
; .
; Border: cyan (5). Conveyor: none. Ramp: none.
; .
; Items: none in the item table.
; .
; Exits: left Room 27 (The Chapel, #R$DB00); right Room 0 (The Off Licence,
; #R$C000); up Room 32 (Halfway up the East Wall, #R$E000); down Room 20
; (Ballroom East, #R$D400). Odd: the left edge of the layout is walled in (no
; free cell next to it), so the left exit (byte 27) cannot be used by walking
; (inferred from the layout).
; .
; Entities: slot 0: definition $60 (at $A300) start $03; slot 1: definition
; $2D (at $A168) start $27. List ends at slot 2 ($FF).
@label=RoomEastWallBase
b$DA00 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 0: ##........##....................
 $DA08 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 1: ##........##....................
 $DA10 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 2: ##........##....................
 $DA18 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 3: ##........##....................
 $DA20 DEFB $A0,$00,$1A,$00,$00,$00,$00,$00 ; row 4: ##.......-##....................
 $DA28 DEFB $A0,$04,$0A,$00,$00,$00,$00,$00 ; row 5: ##....-...##....................
 $DA30 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 6: ##........##....................
 $DA38 DEFB $A4,$00,$0A,$00,$00,$00,$00,$00 ; row 7: ##-.......##....................
