 $DA58 DEFB $A0,$10,$0A,$00,$00,$00,$00,$00 ; row 11: ##...-....##....................
 $DA60 DEFB $A0,$00,$0A,$00,$00,$00,$00,$00 ; row 12: ##........##....................
 $DA68 DEFB $A0,$04,$0A,$00,$00,$00,$00,$00 ; row 13: ##....-...##....................
 $DA70 DEFB $A0,$00,$1A,$00,$00,$00,$00,$00 ; row 14: ##.......-##....................
 $DA78 DEFB $A0,$40,$0A,$00,$00,$00,$00,$00 ; row 15: ##..-.....##....................
; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $DA80 DEFM "         East Wall Base         "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $DAA0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $DAA9 DEFB $05,$5B,$A4,$A4,$55,$0A,$00,$00,$00 ; tile 1 (floor): cyan on black
 $DAB2 DEFB $26,$59,$25,$26,$D9,$29,$D6,$54,$96 ; tile 2 (wall): yellow on green
 $DABB DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 3 (nasty): bright white on white, flashing [not used in this room]
 $DAC4 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 4 (ramp): bright white on white, flashing [not used in this room]
 $DACD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $DAD6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $DADA DEFB $00,$00,$00,$00 ; no ramp (length 0)
; Border colour; then $DF-$E0, not read by any code.
 $DADE DEFB $05,$00,$00 ; border cyan (5); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $DAE1 DEFB $00,$00,$00,$00,$00,$00,$00,$00 ; item graphic (all zeros: blank)
; Exits: room numbers left, right, up, down.
 $DAE9 DEFB $1B,$00,$20,$14 ; left 27, right 0, up 32, down 20
; Three bytes not read by any code.
 $DAED DEFB $00,$00,$00 ; unused
; Entity slots: definition index, start byte (see #R$C000).
 $DAF0 DEFB $60,$03 ; definition $60, start $03 (column 3)
 $DAF2 DEFB $2D,$27 ; definition $2D, start $27 (column 7)
 $DAF4 DEFB $FF,$00 ; end of list
 $DAF6 DEFB $00,$00 ; empty
 $DAF8 DEFB $00,$00 ; empty
 $DAFA DEFB $00,$00 ; empty
 $DAFC DEFB $00,$00 ; empty
