; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $D480 DEFM "         Ballroom East          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $D4A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $D4A9 DEFB $06,$AA,$55,$22,$44,$22,$44,$22,$44 ; tile 1 (floor): yellow on black
 $D4B2 DEFB $0F,$44,$44,$FF,$11,$11,$FF,$55,$AA ; tile 2 (wall): white on blue
 $D4BB DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 3 (nasty): bright white on white, flashing [not used in this room]
 $D4C4 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 4 (ramp): bright white on white, flashing [not used in this room]
 $D4CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $D4D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $D4DA DEFB $00,$00,$00,$00 ; no ramp (length 0)
; Border colour; then $DF-$E0, not read by any code.
 $D4DE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $D4E1 DEFB $81,$81,$42,$24,$18,$18,$18,$E7 ; item graphic
; Exits: room numbers left, right, up, down.
 $D4E9 DEFB $15,$0B,$1A,$00 ; left 21, right 11, up 26, down 0
; Three bytes not read by any code.
 $D4ED DEFB $00,$00,$00 ; unused
