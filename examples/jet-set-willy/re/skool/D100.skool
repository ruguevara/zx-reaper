; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $D180 DEFM "      Up on the Battlements     "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $D1A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $D1A9 DEFB $04,$80,$C0,$E0,$B0,$90,$94,$D6,$77 ; tile 1 (floor): green on black
 $D1B2 DEFB $0E,$00,$7F,$7F,$63,$6B,$63,$7F,$7F ; tile 2 (wall): yellow on blue
 $D1BB DEFB $20,$4A,$2A,$1A,$48,$6C,$6A,$29,$88 ; tile 3 (nasty): black on green
 $D1C4 DEFB $04,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 4 (ramp): green on black [not used in this room]
 $D1CD DEFB $42,$28,$AA,$0A,$00,$55,$55,$55,$FF ; tile 5 (conveyor): bright red on black
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $D1D6 DEFB $00,$2D,$5F,$05 ; direction 0 (left), address $5F2D = row 9 column 13, 5 cells
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $D1DA DEFB $00,$00,$00,$00 ; no ramp (length 0)
; Border colour; then $DF-$E0, not read by any code.
 $D1DE DEFB $01,$00,$00 ; border blue (1); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $D1E1 DEFB $18,$24,$18,$2C,$5E,$5E,$E7,$66 ; item graphic
; Exits: room numbers left, right, up, down.
 $D1E9 DEFB $12,$10,$00,$00 ; left 18, right 16, up 0, down 0
; Three bytes not read by any code.
 $D1ED DEFB $00,$00,$00 ; unused
