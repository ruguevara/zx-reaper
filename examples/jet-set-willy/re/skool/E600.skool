; Room name: 32 characters, printed at the bottom of the screen when the room is entered.
 $E680 DEFM "         Priests' Hole          "
; Six tiles of 9 bytes: attribute, then 8 pixel rows. Tile 0 background, 1 floor, 2 wall, 3 nasty, 4 ramp, 5 conveyor.
 $E6A0 DEFB $00,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 0 (background): black on black
 $E6A9 DEFB $06,$55,$55,$5D,$D7,$70,$00,$00,$00 ; tile 1 (floor): yellow on black
 $E6B2 DEFB $2A,$22,$11,$44,$88,$22,$11,$44,$88 ; tile 2 (wall): red on cyan
 $E6BB DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 3 (nasty): bright white on white, flashing [not used in this room]
 $E6C4 DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 4 (ramp): bright white on white, flashing [not used in this room]
 $E6CD DEFB $FF,$00,$00,$00,$00,$00,$00,$00,$00 ; tile 5 (conveyor): bright white on white, flashing [not used in this room]
; Conveyor: direction, address of the leftmost cell in the attribute buffer, length in cells.
 $E6D6 DEFB $00,$00,$00,$00 ; no conveyor (length 0)
; Ramp: direction, attribute buffer address of its lowest cell, length in cells.
 $E6DA DEFB $00,$00,$00,$00 ; no ramp (length 0)
; Border colour; then $DF-$E0, not read by any code.
 $E6DE DEFB $02,$00,$00 ; border red (2); $DF-$E0 = $00,$00
; Item graphic: 8 pixel rows shared by all items of the room.
 $E6E1 DEFB $BF,$BF,$BB,$B1,$BB,$BB,$BF,$BF ; item graphic
; Exits: room numbers left, right, up, down.
 $E6E9 DEFB $27,$00,$3C,$20 ; left 39, right 0, up 60, down 32
; Three bytes not read by any code.
 $E6ED DEFB $00,$00,$00 ; unused
; Entity slots: definition index, start byte (see #R$C000).
 $E6F0 DEFB $10,$84 ; definition $10, start $84 (column 4)
 $E6F2 DEFB $11,$A6 ; definition $11, start $A6 (column 6)
 $E6F4 DEFB $12,$C5 ; definition $12, start $C5 (column 5)
 $E6F6 DEFB $25,$16 ; definition $25, start $16 (column 22)
