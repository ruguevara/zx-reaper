; Leave the room through the right exit
;
; Makes the right neighbour (byte $EA of the room, $80EA) the current
; room and puts Willy on column 0 of the same row (column bits of his
; attribute address #R$85D3 cleared). Pops the caller's return address and
; jumps to #R$8912, which loads the new room and restarts the game loop, so
; it never returns.
; .
; Reached when Willy walks past column 31 (jump from #R$8DD3).
@label=ExitRoomRight
c$949E LD A,($80EA)  ;
 $94A1 LD ($8420),A  ; new current room
 $94A4 LD A,($85D3)  ;
@isub=AND ~COLUMN_MASK
 $94A7 AND $E0       ; column = 0, row bits unchanged
 $94A9 LD ($85D3),A  ;
 $94AC POP HL        ; drop the return address
 $94AD JP $8912      ; load the new room
