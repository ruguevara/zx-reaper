; Sprite: Willy facing right, walk frame 0
;
; One 16x16 sprite of 32 bytes: 16 pixel rows of 2 bytes (left byte, right byte; bit 7 = leftmost pixel), drawn with
; #R$9456. Willy walking to the right (observed: key P gives $85D0 = 2, bit 0 clear), walk frame 0. #R$9637 draws Willy
; from $9D00 + 128*(bit 0 of #R$85D0) + 32*(#R$85D2 AND 3); the lives indicator #R$898B shows frames 0-3 in turn (frame
; counter #R$85E1).
@label=SpriteWillyRight0
b$9D00 DEFB $3C,$00
 $9D02 DEFB $3C,$00
 $9D04 DEFB $7E,$00
 $9D06 DEFB $34,$00
 $9D08 DEFB $3E,$00
 $9D0A DEFB $3C,$00
 $9D0C DEFB $18,$00
 $9D0E DEFB $3C,$00
 $9D10 DEFB $7E,$00
 $9D12 DEFB $7E,$00
 $9D14 DEFB $F7,$00
 $9D16 DEFB $FB,$00
 $9D18 DEFB $3C,$00
 $9D1A DEFB $76,$00
 $9D1C DEFB $6E,$00
