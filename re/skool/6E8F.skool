; Title bitmap: the word "HUNGRY" in 2x2-block letters
;
; The big title word HUNGRY. A picture of 32 x 5 character cells (160 bytes, one byte per cell), cells left to right
; and then down. Each byte describes the four 4x4-pixel blocks of its 8x8 cell: bit 4 = top-left block, bit 5 = top-
; right, bit 0 = bottom-left, bit 1 = bottom-right (1 = block set, bits 2, 3, 6 and 7 unused). So $33 is a solid cell,
; $11 its left half, $22 its right half and $00 an empty cell. Seen as 64 x 10 blocks the letters are about 9 blocks
; wide and 10 tall, separated by one or two empty block columns.
; .
; Drawn by #R$6000 with #R$6D4E (DrawBlocks) at screen address $40A0 (character rows 5-9); the title loop then cycles
; the attributes of these rows to colour the letters. The other word is #R$6F2F.
;
@label=TitleHungry
b$6E8F DEFB $33,$11,$00,$33,$11,$22,$33,$00,$22,$33,$00,$33,$11,$00,$33,$11
 $6E9F DEFB $00,$23,$31,$33,$01,$00,$33,$31,$32,$13,$00,$22,$33,$00,$22,$33
 $6EAF DEFB $33,$11,$00,$33,$11,$22,$33,$00,$22,$33,$00,$33,$33,$01,$33,$11
 $6EBF DEFB $22,$33,$00,$20,$30,$00,$33,$11,$00,$33,$11,$22,$33,$00,$22,$33
 $6ECF DEFB $33,$13,$03,$33,$11,$22,$33,$00,$22,$33,$00,$33,$31,$33,$33,$11
 $6EDF DEFB $22,$33,$02,$03,$03,$00,$33,$13,$23,$31,$00,$00,$32,$13,$33,$10
 $6EEF DEFB $33,$11,$00,$33,$11,$22,$33,$00,$22,$33,$00,$33,$11,$20,$33,$11
 $6EFF DEFB $22,$33,$00,$22,$33,$00,$33,$31,$33,$01,$00,$00,$00,$33,$11,$00
 $6F0F DEFB $33,$11,$00,$33,$11,$00,$32,$13,$33,$10,$00,$33,$11,$00,$33,$11
 $6F1F DEFB $00,$32,$13,$33,$10,$00,$33,$11,$20,$33,$01,$00,$00,$33,$11,$00
